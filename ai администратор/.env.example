# =============================================================================
#  .env.example — шаблон переменных окружения для бэкенда MAYA
# =============================================================================
#  ИСПОЛЬЗОВАНИЕ:
#    cp .env.example .env
#    chmod 600 .env
#    впиши НОВЫЕ (ротированные) значения справа от "="
#  Файл .env НИКОГДА не коммитить (он уже в .gitignore). Здесь — только пустой
#  шаблон без секретов, его коммитить можно.
#
#  Формат: KEY=значение  (без кавычек, без пробелов вокруг "=")
# =============================================================================

# --- Telegram (бот @malesthetic_bot) ---
# Где взять: @BotFather → /token (или /revoke для нового). СЧИТАТЬ СТАРЫЙ СКОМПРОМЕТИРОВАННЫМ.
TELEGRAM_TOKEN=

# Прокси для Telegram/OpenAI, если нужен. Формат http://user:pass@host:port. Пусто = напрямую.
PROXY_URL=

# --- OpenAI (основной мозг MAYA/Telegram-бота + голос + cutmatch) ---
# Где взять: platform.openai.com → API keys. Лучше отдельный ключ под этот backend.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.5
OPENAI_FAST_MODEL=gpt-5.4-mini
OPENAI_TELEGRAM_CHAT_MODEL=gpt-5.5-pro
OPENAI_PWA_CHAT_MODEL=gpt-5.5-pro
# Та же Pro-модель, но быстрее для клиентской записи/FAQ. Допустимо: medium, high, xhigh.
OPENAI_CLIENT_REASONING_EFFORT=medium
OPENAI_VOICE_CHAT_MODEL=gpt-5.5-pro
REALTIME_VAD_EAGERNESS=medium
MASTERS_OPENAI_MODEL=gpt-5.5
MASTER_DAY_BRIEF_SEND_HOUR=8
CUTMATCH_ENABLED=False

# --- DeepSeek V4 (text chats; direct API, no shared OpenAI proxy) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_PROXY_URL=
DEEPSEEK_THINKING=disabled
# Recommended routing after a live key/tool-call check:
# OPENAI_PWA_CHAT_MODEL=deepseek-v4-pro
# OPENAI_TELEGRAM_CHAT_MODEL=deepseek-v4-pro
# OPENAI_CHAT_MODEL=deepseek-v4-flash
# OPENAI_FAST_MODEL=deepseek-v4-flash

# --- Аудиосообщения MAYA (STT, только распознавание входа) ---
VOICE_STT_PROVIDER=openai
STT_MODEL=gpt-4o-transcribe
# При временном сбое OpenAI аудио останется на VPS и будет распознано local Whisper.
VOICE_STT_ALLOW_LOCAL_FALLBACK=True
# Используется только в режиме VOICE_STT_PROVIDER=auto.
VOICE_STT_ALLOW_EXTERNAL_FALLBACK=False
VOICE_STT_MAX_BYTES=8388608
VOICE_STT_LOCAL_MODEL=base

# --- Голос MAYA через Yandex SpeechKit (TTS, озвучивание ответов) ---
# API-ключ сюда вписывать только в настоящий .env на сервере, не в чат и не в Git.
# Для выбранного в AI Studio голоса «Лера / Дружелюбный»:
VOICE_REPLIES_ENABLED=True
VOICE_TTS_PROVIDER=yandex
VOICE_TTS_FALLBACK_OPENAI=False
YANDEX_SPEECHKIT_API_KEY=
YANDEX_CLOUD_FOLDER_ID=
YANDEX_SPEECHKIT_VOICE=lera
YANDEX_SPEECHKIT_ROLE=friendly
YANDEX_SPEECHKIT_SPEED=1.0
YANDEX_SPEECHKIT_PITCH_SHIFT=0
YANDEX_SPEECHKIT_MAX_CHARS=240

# --- Anthropic Claude (legacy/fallback, можно оставить пустым) ---
CLAUDE_API_KEY=

# --- YClients ---
# Где взять: кабинет партнёра YClients. partner = платформенный, user = токен пользователя.
YCLIENTS_PARTNER_TOKEN=
YCLIENTS_USER_TOKEN=

# --- VK ID (вход через ВК; сейчас выключен VK_LOGIN_ENABLED=False) ---
# Где взять: dev.vk.com → приложение → «Защищённый ключ» (client_secret).
VK_SECURE_KEY=

# --- Yandex ID (вход через Яндекс; нужен OAuth app, не SpeechKit key) ---
# Где взять: oauth.yandex.ru → приложение → Client ID / Client secret.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=https://malesthetic.pro/app/
YANDEX_LOGIN_ENABLED=False

# --- Репутация на картах ---
# Снимки Яндекса можно обновлять через owner import/API; формат ручного fallback:
SALON_RATING_YANDEX=
SALON_RATING_2GIS=
# Официальный 2ГИС Places API отдаёт рейтинг и количество отзывов, но не их тексты.
TWOGIS_API_KEY=
TWOGIS_BRANCH_ID=70000001038177627

# --- ЮKassa (приём платежей за сертификаты/абонементы) ---
# Где взять: ЛК ЮKassa → Настройки → Ключи API. Секретный ключ начинается с 'live_'. ЭТО ДЕНЬГИ.
YUKASSA_SECRET_KEY=
# Provider Token для Telegram Payments (legacy, можно оставить пустым если не используется).
YUKASSA_PROVIDER_TOKEN=

# --- SMS.ru (вход по телефону; пусто = канал отключён) ---
# Где взять: ЛК sms.ru → api_id.
SMSRU_API_ID=

# --- Webhook-секрет (бот ↔ PHP-прокси на Beget) ---
# Сгенерируй новый и впиши ТО ЖЕ значение в api-proxy.php/tg-config на Beget.
# Пример генерации: python -c "import secrets;print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# Read-only bridge to MAYA OS during migration. Use the same random value in
# maya-saas-backend; never expose it in the browser or commit the real token.
MAYA_LEGACY_BRIDGE_TOKEN=

# --- Legacy appointment bridge (Python initiator -> Nest Action Engine) ---
# Rollout sequence: off -> shadow -> cutover. Invalid values fail closed.
# In shadow the old path executes once and Nest only previews. In cutover the
# bridge is the only execution route; transport failures never fall back to CRM.
MAYA_LEGACY_APPOINTMENT_BRIDGE_MODE=off
MAYA_LEGACY_APPOINTMENT_BRIDGE_URL=http://127.0.0.1:3107/api/internal/legacy/appointment-actions
MAYA_LEGACY_APPOINTMENT_BRIDGE_TOKEN=
MAYA_LEGACY_APPOINTMENT_BRIDGE_TIMEOUT_SECONDS=8

# Dual-write proactive MAYA messages into Nest inbox (Maya OS app persistence).
# Same token as maya-saas-backend MAYA_INBOX_BRIDGE_TOKEN. Empty = no-op.
MAYA_INBOX_BRIDGE_TOKEN=
# Optional distinct HMAC key. Must match the backend value when configured.
# Empty = derive pseudonymous recovery identifiers from the bridge token.
MAYA_RECOVERY_ATTRIBUTION_SECRET=
MAYA_RECOVERY_INGEST_URL=http://127.0.0.1:3107/api/recovery/internal/touchpoints
# On the VPS bot host Nest listens on 3107 locally; keep this for same-machine dual-write.
MAYA_INBOX_INGEST_URL=http://127.0.0.1:3107/api/inbox/internal/ingest
MAYA_INBOX_TENANT_SLUG=muzhskaya-estetika
# 1 = Nest owns morning/evening inbox cards (default). Bot still may send Telegram for ME.
MAYA_OWNER_REPORTS_VIA_NEST=1

# --- Ключ шифрования ПД (Fernet, 152-ФЗ) ---
# ⚠️ НЕ генерировать новый, если в боевой базе уже есть зашифрованные ПД — иначе они
#    станут нечитаемыми. Сюда вписать ДЕЙСТВУЮЩИЙ ключ. Ротация — только с миграцией данных.
# Новый (для чистой базы): python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=
