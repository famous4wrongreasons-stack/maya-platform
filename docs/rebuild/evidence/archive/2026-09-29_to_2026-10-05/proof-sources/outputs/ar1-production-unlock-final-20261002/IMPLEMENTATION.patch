+                'content-type': 'application/json',
+              },
+              ...(body ? { body: JSON.stringify(body) } : {}),
+            },
+          );
+          return {
+            status: response.status,
+            body: (await response.json()) as unknown,
+          };
+        };
+        return { call, stop };
+      } catch (error) {
+        await stop();
+        throw error;
+      }
+    }
