+    expect(p.policy.view('tenant', row, row.expiresAt)).toBeNull();
+    p.config.set('WIDGET_RELEASE_PRODUCTION_TENANTS_JSON', '[]');
+    expect(p.policy.view('tenant', row, now)).toBeNull();
+  });
+});
