{
 "contract": "maya.legacy-bundle-remediation/1",
 "ruling": "R3 — move every confirmed publicly reachable legacy bundle copy out of the served document roots into a non-public archive. Not a deletion. Not K16.",
 "inventoriedAt": "2026-09-16T18:31Z",
 "movedAt": "2026-09-16T18:32:21Z",
 "redaction": "The repository is PUBLIC. Source paths, URLs and the archive path are withheld. They sit in the owner-only rollback manifest, whose sha256 is recorded below, stored privately on the host and handed to the owner.",
 "method": [
  "fresh read-only inventory of every *.html* file carrying a legacy authority or role-mode token, or larger than 300 KB, in the three served docroots (92 candidates)",
  "HTTP HEAD per candidate: 44 answered 200 with content-length equal to the file size; 48 answered 403 and were left untouched",
  "rollback manifest (index, source URL, host docroot, relative path, bytes, mtime, mode, owner, sha256, archive path) written to a mode-700 archive directory OUTSIDE every docroot before any move",
  "per file: re-hash immediately before the move (skip if changed), mv -n on the same filesystem (a rename), re-hash the archived copy",
  "after: HEAD every source URL; GET and hash seven canonical entries before and after"
 ],
 "rollbackManifestSha256": "f93c052092bd9ca68a04b4ec56fbe9ee2068ce92345c7f4e606454369e44342e",
 "archiveId": "r3-20260916",
 "archiveLocation": "a home-directory archive on the same host and filesystem, outside every served docroot, mode 700",
 "results": {
  "moved": 44,
  "skipped": 0,
  "failed": 0,
  "sha256EqualAfterMove": 44,
  "mtimePreserved": 44,
  "sourceUrlsNowServing200": 0,
  "sourceUrlsNow404": 44,
  "byHost": {
   "mayaos.ru": 35,
   "malesthetic.pro": 7,
   "beget-technical-domain": 2
  },
  "candidatesInventoried": 92,
  "confirmedPublicAndInManifest": 44
 },
 "modeNote": "34 files that were mode 644 read 600 in the archive, and the other 10 kept their mode. The move did not do this: the host re-applied the archive directory's ACL policy at move time, removing the web identity's ACL entry and the group/other bits, with ctime equal to the move second. Content, owner and mtime are unchanged. Rollback restores the recorded mode explicitly.",
 "rollback": {
  "procedure": "for each manifest row: mv -n <archive path> <source path>; chmod <recorded mode>; verify sha256 equals the manifest; verify the source URL answers 200 again",
  "exercised": false,
  "whyNotExercised": "exercising it would re-expose the bundles the ruling exists to close; the procedure is a rename plus chmod against a manifest verified on both ends"
 },
