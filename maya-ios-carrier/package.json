{
  "name": "maya-ios-carrier",
  "version": "1.0.0",
  "private": true,
  "description": "The canonical iOS carrier for MAYA. It carries the shared chat-first shell and owns no product logic.",
  "scripts": {
    "shell": "node ../maya-chat-shell/build.mjs --target=capacitor",
    "sync": "npm run shell && cap sync ios",
    "open": "cap open ios",
    "doctor": "cap doctor ios"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/status-bar": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1"
  }
}
