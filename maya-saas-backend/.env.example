DATABASE_URL="postgresql://postgres:postgres@localhost:5432/maya_saas?schema=public"
JWT_SECRET="change-me-in-production"
JWT_ACCESS_TTL_SECONDS="900"
AUTH_REFRESH_TOKEN_TTL_DAYS="30"
AUTH_REFRESH_TOKEN_SECRET="change-me-to-an-independent-random-secret"
AUTH_SESSION_METADATA_SECRET="change-me-to-another-independent-random-secret"
AUTH_RATE_LIMIT_SECRET="change-me-to-a-third-independent-random-secret"
# Хеш личности клиента. Отдельный домен безопасности: ротируется независимо
# от сессий и токенов. Обязателен в production.
CLIENT_IDENTITY_HASH_SECRET="change-me-to-an-independent-client-identity-secret"
# Список доверенных прокси. В production ОБЯЗАТЕЛЕН: приложение живёт за nginx,
# и без него request.ip у всех запросов равен адресу прокси, а лимиты со scope
# 'ip' считают одного субъекта на всю платформу. Для локальной разработки без
# прокси значение не нужно.
AUTH_TRUST_PROXY=""
AUTH_RETENTION_SESSION_DAYS="30"
AUTH_RETENTION_CHALLENGE_HOURS="24"
AUTH_RETENTION_RATE_LIMIT_HOURS="24"
AUTH_RETENTION_BATCH_SIZE="1000"
AI_TOOL_RETENTION_DAYS="30"
AI_TOOL_STALE_EXECUTION_MINUTES="15"
# ВНИМАНИЕ: "safe" здесь означает НЕ «безопасная модель», а «модели нет вообще» —
# запрос к провайдеру не делается, и MAYA отвечает заготовками из кода.
# 🔴 Это ЕДИНСТВЕННЫЙ переключатель провайдера. Второй (MAYA_BRAIN_PROVIDER)
# убран: он перекрывал этот только на нативном канале, и пустое значение
# выключало модель ровно там, где мозг включали.
AI_CORE_PROVIDER="auto"
AI_CORE_TIMEOUT_MS="20000"
AI_CORE_MAX_TOOL_STEPS="3"
AI_CORE_MAX_OUTPUT_TOKENS="4000"
AI_SPEECH_TIMEOUT_MS="20000"
YANDEX_SPEECHKIT_API_KEY=""
MAYA_NATIVE_SCHEDULE_ACTIONS_ENABLED="true"
# Пусто = deepseek-v4-pro. Основной чат и onboarding используют Pro.
DEEPSEEK_AI_CORE_MODEL="deepseek-v4-pro"
OPENAI_AI_CORE_MODEL=""
CRM_ENCRYPTION_KEY="change-me-in-production"
# Stable HMAC key for one-time loyalty claim lookup. Raw bearer values are not
# stored; this secret must be independent from all other production secrets.
MAYA_LOYALTY_REDEMPTION_CODE_PEPPER="change-me-to-an-independent-loyalty-redemption-secret"
# Stable referral-discount presentation PRF and independent claim-lookup HMAC.
# Raw reward bearer values are never persisted. Keep old version keys available
# through MAYA_REFERRAL_REWARD_PRESENTATION_KEYS during a controlled rotation.
MAYA_REFERRAL_REWARD_PRESENTATION_KEY="change-me-to-an-independent-referral-presentation-secret"
MAYA_REFERRAL_REWARD_PRESENTATION_KEY_VERSION="v1"
MAYA_REFERRAL_REWARD_PRESENTATION_KEYS=""
MAYA_REFERRAL_REWARD_CLAIM_SECRET="change-me-to-an-independent-referral-claim-secret"
# Stable gift-certificate presentation PRF and independent bearer lookup HMAC.
# Retain old presentation keys by version during controlled key rotation.
MAYA_GIFT_CERTIFICATE_PRESENTATION_KEY="change-me-to-an-independent-gift-certificate-presentation-secret"
MAYA_GIFT_CERTIFICATE_PRESENTATION_KEY_VERSION="v1"
MAYA_GIFT_CERTIFICATE_PRESENTATION_KEYS=""
MAYA_GIFT_CERTIFICATE_CLAIM_SECRET="change-me-to-an-independent-gift-certificate-claim-secret"
PORT=3000
HOST="0.0.0.0"
NODE_ENV="development"
CORS_ALLOWED_ORIGINS="http://127.0.0.1:8787,http://localhost:8787,capacitor://localhost"
SWAGGER_ENABLED="true"
SELF_SERVE_TRIAL_SIGNUP="false"
PWA_TENANT_INSTALL_ENABLED="false"
PWA_PUBLIC_APP_URL="http://127.0.0.1:8787/app.html"
PWA_PUBLIC_API_URL="http://127.0.0.1:3000/api"
AI_ONBOARDING_PROVIDER="auto"
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_AI_ONBOARDING_MODEL="deepseek-v4-pro"
DEEPSEEK_AI_ONBOARDING_TIMEOUT_MS="12000"
DEEPSEEK_THINKING="disabled"
OPENAI_API_KEY=""
OPENAI_AI_ONBOARDING_MODEL="gpt-5.4-mini"
OPENAI_AI_ONBOARDING_TIMEOUT_MS="12000"
TENANT_BASE_DOMAIN="malesthetic.pro"
SEED_DEFAULT_TENANT_SLUG="malesthetic"
SEED_DEFAULT_TENANT_NAME="Мужская Эстетика"
SEED_PLATFORM_OWNER_EMAIL="owner@maya.local"
SEED_PLATFORM_OWNER_PASSWORD="replace-me-before-seeding"
SEED_DEMO_TENANT_ADMIN_EMAIL="admin@demo-business.local"
SEED_DEMO_TENANT_ADMIN_PASSWORD="replace-me-before-seeding"
YCLIENTS_BASE_URL="https://api.yclients.com/api/v1"
YCLIENTS_PARTNER_TOKEN="change-me-in-production"
# Read-only compatibility bridge for tenants migrating from the existing MAYA ledger.
MAYA_LEGACY_BRIDGE_URL="http://127.0.0.1:8080/api/internal/loyalty-snapshot"
MAYA_LEGACY_BRIDGE_TOKEN=""
MAYA_LEGACY_LOYALTY_TENANT_SLUGS=""
# Authenticated internal bridge for legacy appointment initiators. Shadow
# preview is available with the token; mutation remains disabled until the
# explicit cutover flag is enabled after organic equivalence observation.
MAYA_LEGACY_APPOINTMENT_BRIDGE_TOKEN=""
# Server-side binding for the credential above. Request payloads cannot select
# another tenant; provider/company values must match this trusted source.
MAYA_LEGACY_APPOINTMENT_BRIDGE_SOURCE_PROVIDER="yclients"
MAYA_LEGACY_APPOINTMENT_BRIDGE_SOURCE_COMPANY_ID=""
MAYA_LEGACY_APPOINTMENT_BRIDGE_EXECUTION_ENABLED="false"
# Dual-write legacy Telegram bot reports into Nest persistent inbox.
MAYA_INBOX_BRIDGE_TOKEN=""
# Optional distinct HMAC key for PII-free recovery attribution. If empty, the
# inbox bridge token is used so the legacy bot and Nest derive the same subject.
MAYA_RECOVERY_ATTRIBUTION_SECRET=""
MAYA_RECOVERY_INGEST_URL="http://127.0.0.1:3107/api/recovery/internal/touchpoints"
# Used by the Python bot when posting inbox items.
MAYA_INBOX_INGEST_URL="http://127.0.0.1:3107/api/inbox/internal/ingest"
MAYA_INBOX_TENANT_SLUG="muzhskaya-estetika"
# Nest-native owner morning/evening reports (no Telegram bot per tenant).
OWNER_REPORTS_SCHEDULER_ENABLED="true"
OWNER_REPORTS_SCHEDULER_INTERVAL_MINUTES="5"
OWNER_REPORTS_MORNING_HOUR="8"
OWNER_REPORTS_EVENING_HOUR="21"
# Comma-separated rollout allowlist. Empty = all eligible tenants (pilot default).
OWNER_REPORTS_TENANT_SLUGS=""
# Native iOS push for inbox announcements (optional until key is installed).
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_BUNDLE_ID="ru.mayaos.app"
# Either inline PEM (\\n escaped) or a root-only file path on the VPS.
APNS_KEY_P8=""
APNS_KEY_PATH=""
# Set to 1 for App Store / TestFlight production APNs host.
APNS_PRODUCTION="0"
PHONE_LOGIN_ENABLED="true"
PHONE_AUTH_PROVIDER="auto"
PHONE_AUTH_DEBUG="false"
PHONE_AUTH_FIXED_CODE=""
PHONE_AUTH_SECRET="change-me-to-a-fourth-independent-random-secret"
PHONE_AUTH_CODE_TTL="300"
PHONE_AUTH_RESEND_COOLDOWN_SECONDS="60"
PHONE_AUTH_MAX_ATTEMPTS="5"
PHONE_AUTH_SMS_TEMPLATE="MAYA: код входа {{code}}. Никому не сообщайте его."
SMSRU_API_ID=""
SMSRU_FROM=""
SMSRU_TEST="false"
SMSRU_TIMEOUT_MS="15000"
EMAIL_LOGIN_ENABLED="false"
EMAIL_AUTH_PROVIDER="auto"
EMAIL_AUTH_DEBUG="false"
