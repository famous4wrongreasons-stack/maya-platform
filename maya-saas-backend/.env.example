OAUTH_PROVIDER_TIMEOUT_MS="15000"
OAUTH_ALLOWED_REDIRECT_URIS="https://maya.example/oauth-callback.html,https://maya.example/api/auth/oauth/native/callback,http://127.0.0.1:8787/oauth-callback.html,http://localhost:8787/oauth-callback.html"
OAUTH_NATIVE_REDIRECT_URI="https://maya.example/api/auth/oauth/native/callback"
YANDEX_LOGIN_ENABLED="false"
YANDEX_CLIENT_ID=""
YANDEX_CLIENT_SECRET=""
TELEGRAM_LOGIN_ENABLED="false"
TELEGRAM_CLIENT_ID=""
