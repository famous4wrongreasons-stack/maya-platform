{$STAGING_HOST} {
  encode zstd gzip

  # No request/access log: OAuth query values must not enter a gateway receipt.

  @api path /api/*
  handle @api {
    reverse_proxy backend:3000
  }

  @oauthCallback path /oauth-callback.html
  handle @oauthCallback {
    root * /srv/maya-callback
    header {
      -Server
      Cache-Control "no-store"
      Referrer-Policy "no-referrer"
      X-Content-Type-Options "nosniff"
      X-Frame-Options "DENY"
    }
    file_server
  }

  handle {
    root * /srv/maya
    try_files {path} /index.html
    header {
      -Server
      Cache-Control "no-store"
      Referrer-Policy "no-referrer"
      X-Content-Type-Options "nosniff"
      X-Frame-Options "DENY"
      Permissions-Policy "camera=(self), microphone=(self), geolocation=(self)"
    }
    file_server
  }
}
