[Unit]
Description=MAYA Telegram OAuth egress tunnel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botadmin
Group=botadmin
ExecStart=/usr/bin/ssh -NT -D 127.0.0.1:1081 -i /home/botadmin/.ssh/maya_telegram_egress -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o StrictHostKeyChecking=yes mocine3388@prime.beget.com
Restart=always
RestartSec=5
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=read-only
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
