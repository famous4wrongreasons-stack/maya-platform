// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  trial
  active
  past_due
  suspended
  cancelled
}

enum UserRole {
  platform_owner
  platform_admin
  tenant_owner
  business_owner
  administrator
  manager
  provider
  employee
  accountant
  customer
  integration_service
  tenant_admin
  branch_manager
  staff
  client
}

enum UserStatus {
  active
  suspended
  invited
  // Терминальный статус погашенного дубля. Обратно в active не переводится:
  // suspended для этой роли не подходит — его воскрешает сверка с CRM.
  merged
}

enum MembershipStatus {
  active
  suspended
  invited
}

enum CrmStaffAccessStatus {
  pending_contact
  active
  disabled
}

enum CalendarSource {
  internal
  external
}

enum OpportunityLifecycleStatus {
  active
  resolved
  expired
  superseded
}

enum OpportunityOutcome {
  inform_only
  investigation_required
  action_candidate
}

enum OpportunityAgentDomain {
  admin
  client_lifecycle
  occupancy
  business_intelligence
}

enum AgentTaskLifecycleStatus {
  current
  invalidated
}

enum ActionExecutionState {
  PENDING_APPROVAL
  READY
  EXECUTING
  UNKNOWN
  SUCCEEDED
  FAILED
  NOT_EXECUTED
}

enum ActionPolicyDecision {
  ALLOW
  DENY
  SHADOW_ONLY
}

enum ActionApprovalDecision {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum ActionReconciliationState {
  NOT_REQUIRED
  REQUIRED
  IN_PROGRESS
  RESOLVED
  MANUAL_REQUIRED
}

enum ActionAttemptKind {
  EXECUTION
  RECONCILIATION
}

enum ActionAttemptState {
  STARTED
  SUCCEEDED
  FAILED
  UNKNOWN
}

enum ExternalDispatchState {
  NOT_APPLICABLE
  NOT_CROSSED
  MAY_HAVE_CROSSED
  ACKNOWLEDGED
}

enum CommunicationScope {
  SINGLE
  BULK
}

enum CommunicationDeliveryState {
  NOT_SENT
  ACCEPTED
  DELIVERED
  FAILED
  UNKNOWN
  SKIPPED
}

enum CommunicationCampaignState {
  DRAFT
  READY
  RUNNING
  UNRESOLVED
  COMPLETED
  PARTIAL
  FAILED
  SKIPPED
  CANCELLED
  EXPIRED
  LEGACY_UNRESOLVED
}

model Tenant {
  // MAYA widget layer (D12). Back-relations only: Tenant gains no column, and no business
  // table references a widget table. The only direction that crosses the boundary is
  // widget -> Tenant, which is what makes a widget row tenant-fenceable at all.
  widgetTimelineTurns WidgetTimelineTurn[] @relation("WidgetTimelineTurn_1_fkey")
  widgetEmissions WidgetEmission[] @relation("WidgetEmission_1_fkey")
  widgetIntentRecords WidgetIntentRecord[] @relation("WidgetIntentRecord_1_fkey")
  widgetIntentDivergenceAudits WidgetIntentDivergenceAudit[] @relation("WidgetIntentDivergenceAudit_1_fkey")
  widgetIntentSubmissionAudits WidgetIntentSubmissionAudit[] @relation("WidgetIntentSubmissionAudit_1_fkey")
  widgetIntentReceipts WidgetIntentReceipt[] @relation("WidgetIntentReceipt_1_fkey")
  widgetRenderReceipts WidgetRenderReceipt[] @relation("WidgetRenderReceipt_1_fkey")
  widgetSuppressedEmissions WidgetSuppressedEmission[] @relation("WidgetSuppressedEmission_1_fkey")
  widgetFreeInputLedgers WidgetFreeInputLedger[] @relation("WidgetFreeInputLedger_1_fkey")
  widgetDrafts WidgetDraft[] @relation("WidgetDraft_1_fkey")
  widgetErasureTombstones WidgetErasureTombstone[] @relation("WidgetErasureTombstone_1_fkey")
  // Chapter 9: derived coordination only; source ownership is unchanged.
  c9Runs C9Run[] @relation("C9Run_1_fkey")
  c9StrategyRevisions C9StrategyRevision[] @relation("C9StrategyRevision_1_fkey")
  c9PlanSteps C9PlanStep[] @relation("C9PlanStep_1_fkey")
  c9StepBindings C9StepBinding[] @relation("C9StepBinding_1_fkey")
  c9WorkReceipts C9WorkReceipt[] @relation("C9WorkReceipt_1_fkey")

  c8ModelVersions C8ModelVersion[]
  c8ResultRevisions C8ResultRevision[]
  c8EvaluationRevisions C8EvaluationRevision[]
  measurementRevisions MeasurementRevision[] @relation("C7TenantMeasurement")
  consentInvalidations ClientConsentInvalidation[]
  ownerReportRuns OwnerReportRun[]
  bookingConfirmations ClientBookingConfirmation[]
  id                             String                          @id @default(cuid())
  name                           String
  slug                           String                          @unique
  status                         TenantStatus                    @default(trial)
  planId                         String?
  industryPresetId               String?
  calendarSource                 CalendarSource                  @default(external)
  defaultCurrency                String                          @default("RUB")
  defaultTimezone                String                          @default("Europe/Moscow")
  defaultLocale                  String                          @default("ru-RU")
  customDomain                   String?                         @unique
  subdomain                      String?                         @unique
  trialEndsAt                    DateTime?
  currentPeriodStart             DateTime?
  currentPeriodEnd               DateTime?
  pastDueAt                      DateTime?
  graceEndsAt                    DateTime?
  billingMethodId                String?
  trialFullAccess                Boolean                         @default(false)
  allowSelfRegistration          Boolean                         @default(true)
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
  plan                           SubscriptionPlan?               @relation(fields: [planId], references: [id])
  brandingSettings               BrandingSettings?
  branches                       Branch[]
  users                          User[]
  crmIntegration                 CrmIntegration?
  commerceIntegration            CommerceIntegration?
  auditLogs                      AuditLog[]
  appointments                   Appointment[]
  phoneAuthCodes                 PhoneAuthCode[]
  emailAuthCodes                 EmailAuthCode[]
  authIdentities                 AuthIdentity[]
  clientChannelLinks             ClientChannelLink[]
  authFlowStates                 AuthFlowState[]
  authSessions                   AuthSession[]
  authRateLimitBuckets           AuthRateLimitBucket[]
  billingPayments                BillingPayment[]
  memberships                    Membership[]
  entitlements                   TenantEntitlement[]
  internalServices               InternalService[]
  internalProviders              InternalProvider[]
  availabilityRules              InternalAvailabilityRule[]
  availabilityExceptions         InternalAvailabilityException[]
  aiOnboardingDrafts             AiOnboardingDraft[]             @relation("AiOnboardingConfirmedTenant")
  trialActivation                TrialActivation?
  customerProfiles               CustomerProfile[]
  loyaltyAccounts                LoyaltyAccount[]
  loyaltyTransactions            LoyaltyTransaction[]
  loyaltyRedemptionGrants        LoyaltyRedemptionGrant[]
  loyaltyRedemptions             LoyaltyRedemption[]
  loyaltyGrantRevocations        LoyaltyRedemptionGrantRevocation[]
  unresolvedClientIdentityHolds  UnresolvedClientIdentityHold[]
  expenses                       Expense[]
  expensePeriodDeclarations      ExpensePeriodDeclaration[]
  expensePeriodDeclarationInvalidations ExpensePeriodDeclarationInvalidation[]
  aiApprovalRequests             AiApprovalRequest[]
  aiToolExecutions               AiToolExecution[]
  aiBrainSessions                AiBrainSession[]
  aiMemoryFacts                  AiMemoryFact[]
  aiKnowledgeSources             AiKnowledgeSource[]
  aiKnowledgeChunks              AiKnowledgeChunk[]
  crmStaffAccesses               CrmStaffAccess[]
  dashboardPreferences           DashboardPreference[]
  userMerges                     UserMerge[]
  inboxItems                     InboxItem[]
  domainEvents                   DomainEvent[]
  ingestionQuarantine            IngestionQuarantine[]
  reconciliationRuns             ReconciliationRun[]
  devicePushTokens               DevicePushToken[]
  recoveryTouchpoints            RecoveryTouchpoint[]
  recoveryConversions            RecoveryConversion[]
  marketingAudiences             MarketingAudience[]
  marketingCampaigns             MarketingCampaign[]
  appointmentNotificationSetting AppointmentNotificationSetting?
  catalogItems                   TenantCatalogItem[]
  catalogItemValueVersions       TenantCatalogItemValueVersion[]
  referralProgram                ReferralProgram?
  referralProgramValueVersions   ReferralProgramValueVersion[]
  customerReferrals              CustomerReferral[]
  referralRewardIssuances        ReferralRewardIssuance[]
  referralRewards                ReferralReward[]
  referralRewardFulfillments     ReferralRewardFulfillment[]
  customerSubscriptions          CustomerSubscription[]
  customerSubscriptionUsages     CustomerSubscriptionUsage[]
  giftCertificates               GiftCertificate[]
  giftCertificateRedemptions     GiftCertificateRedemption[]
  businessReviews                BusinessReview[]
  clients                        Client[]
  crmClientLinks                 CrmClientLink[]
  staff                          Staff[]
  staffProviderLinks             StaffProviderLink[]
  marketingPolicy                MarketingPolicy?
  marketingAudienceRecipients    MarketingAudienceRecipient[]
  marketingCampaignRecipients    MarketingCampaignRecipient[]
  marketingConsentEvidence       MarketingConsentEvidence[]
  marketingDeliveryAttempts      MarketingDeliveryAttempt[]
  opportunities                  Opportunity[]
  agentTasks                     AgentTask[]
  actionExecutions               ActionExecution[]
  actionIdempotencyBindings       ActionExecutionIdempotencyBinding[]
  actionAttempts                 ActionAttempt[]
  actionTargetMutations          ActionTargetMutation[]
  operationalWorkItems           OperationalWorkItem[]
  clientConsentFacts             ClientConsentFact[]
  clientLinkChallenges           ClientLinkChallenge[]
  clientWantedSlotInterests       ClientWantedSlotInterest[]
  clientWebPushEndpoints          ClientWebPushEndpoint[]
  maintenanceRuns                MaintenanceRun[]

  @@index([status, graceEndsAt])

  // Wave R-C Option A: approved owner bindings and relations.
  nativeFeedbackRequests NativeFeedbackRequest[] @relation("R08_NativeFeedbackRequest_tenant")
  nativeFeedbackRevisions NativeFeedbackRevision[] @relation("R08_NativeFeedbackRevision_tenant")
  publicCommunityComments PublicCommunityComment[] @relation("R09_PublicCommunityComment_tenant")
  publicCommunityInteractions PublicCommunityInteraction[] @relation("R09_PublicCommunityInteraction_tenant")
  teamMessages TeamMessage[] @relation("R12_TeamMessage_tenant")
  teamAttachments TeamAttachment[] @relation("R12_TeamAttachment_tenant")
  businessConfigurationRevisions TenantBusinessConfigurationRevision[] @relation("R11_TenantBusinessConfigurationRevision_tenant")
  cashDeclarations CashDeclaration[] @relation("R14_CashDeclaration_tenant")
  expenseReminderRuns ExpenseReminderRun[] @relation("R13_ExpenseReminderRun_tenant")
  expenseIntakeBindings ExpenseIntakeBinding[] @relation("R13_ExpenseIntakeBinding_tenant")
  operationalAlertRuns OperationalAlertRun[] @relation("R06_OperationalAlertRun_tenant")
}

/// Durable Chapter 5 interpretation of current canonical evidence. This row
/// stores only opaque evidence references and deterministic policy metadata;
/// it does not own business truth or execution state.
model Opportunity {
  id                          String                     @id @default(cuid())
  tenantId                    String
  type                        String
  identityVersion             Int                        @default(1)
  semanticKey                 String
  identityFingerprint         String
  revision                    Int
  affectedEntityKind          String?
  affectedEntityRef           String?
  evidenceFingerprint         String
  evidenceRefsJson            Json
  evidenceObservedAt          DateTime
  limitationsJson             Json
  policyKey                   String
  policyVersion               Int
  recommendedAgentDomain      OpportunityAgentDomain
  outcome                     OpportunityOutcome
  status                      OpportunityLifecycleStatus @default(active)
  firstDetectedAt             DateTime
  lastValidatedAt             DateTime
  expiresAt                   DateTime
  terminalAt                  DateTime?
  terminalReasonCode          String?
  terminalEvidenceFingerprint String?
  terminalEvidenceRefsJson    Json?
  supersedesOpportunityId     String?
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt
  tenant                      Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supersedes                  Opportunity?               @relation("OpportunitySupersession", fields: [supersedesOpportunityId, tenantId, semanticKey], references: [id, tenantId, semanticKey], onDelete: Restrict)
  supersededBy                Opportunity[]              @relation("OpportunitySupersession")
  agentTasks                  AgentTask[]

  @@unique([id, tenantId])
  @@unique([id, tenantId, semanticKey])
  @@unique([tenantId, identityFingerprint])
  @@unique([tenantId, semanticKey, revision])
  @@unique([tenantId, supersedesOpportunityId])
  @@index([tenantId, status, expiresAt])
  @@index([tenantId, type, status])
  @@index([tenantId, semanticKey, revision])
}

/// Durable Chapter 5 assignment record. It is deliberately not an execution
/// job: retries, approvals, delivery and provider outcomes belong to Chapter 6.
model AgentTask {
  id                      String                   @id @default(cuid())
  tenantId                String
  opportunityId           String
  semanticKey             String
  taskFingerprint         String
  agentDomain             OpportunityAgentDomain
  objectiveKey            String
  allowedReadCapabilities Json
  allowedActionClasses    Json
  autonomyLevel           String                   @default("L2_5_SHADOW")
  status                  AgentTaskLifecycleStatus @default(current)
  requestedAt             DateTime
  expiresAt               DateTime
  invalidatedAt           DateTime?
  invalidationReasonCode  String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  tenant                  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  opportunity             Opportunity              @relation(fields: [opportunityId, tenantId, semanticKey], references: [id, tenantId, semanticKey], onDelete: Restrict)
  actionExecutions        ActionExecution[]

  @@unique([id, tenantId])
  @@unique([tenantId, taskFingerprint])
  @@unique([tenantId, opportunityId, agentDomain])
  @@index([tenantId, status, expiresAt])
  @@index([tenantId, semanticKey, agentDomain, status])
}

/// Canonical Chapter 6 lifecycle for one logical action. It stores a trusted,
/// normalized contract and durable outcome state, never raw model output or
/// unrestricted provider payloads.
model ActionExecution {
  measurementRevisions MeasurementRevision[] @relation("C7ActionExecutionMeasurement")
  consentInvalidations ClientConsentInvalidation[]
  ownerReportRunId String?
  ownerReportSlotKey String?
  ownerReportRun OwnerReportRun? @relation(fields: [ownerReportRunId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict, map: "B36_execution_run_fkey")
  id                        String  @id @default(uuid())
  tenantId                  String
  identityVersion           Int
  identityFingerprint       String
  idempotencyScope          String?
  requestIdempotencyKeyHash String?
  bookingIntentContract    String?
  bookingIntentHash        String?
  bookingIntentEncrypted   String?

  sourceType  String
  sourceRef   String?
  agentTaskId String?
  actorUserId String?

  actionClass              String
  capability               String
  capabilityVersion        Int
  targetKind               String
  targetRef                String
  normalizedInputContract  String
  normalizedInputHash      String
  normalizedInputEncrypted String?
  evidenceRefsJson         Json
  intentExpiresAt          DateTime?
  dryRun                   Boolean   @default(false)

  riskProfileVersion    Int
  riskFacetsJson        Json
  policyKey             String
  policyVersion         Int
  policyDecision        ActionPolicyDecision
  autonomyLevel         String
  policyDecidedBy       String
  policyContextContract String?
  policyContextHash     String?
  policyEvidenceJson    Json?
  policyEvaluatedAt     DateTime?
  policyValidUntil      DateTime?

  approvalRequirement     String
  approvalDecision        ActionApprovalDecision
  approvalInputHash       String?
  approvalBindingHash     String?
  approvalRequestedAt     DateTime?
  approvalExpiresAt       DateTime?
  approvalDecidedAt       DateTime?
  approvalDecidedByUserId String?

  state                       ActionExecutionState
  notExecutedReasonCode       String?
  retryPolicyKey              String
  retryPolicyVersion          Int
  maxExecutionAttempts        Int
  executionAttemptCount       Int                       @default(0)
  nextExecutionAttemptAt      DateTime?
  reconciliationPolicyKey     String
  reconciliationPolicyVersion Int
  reconciliationState         ActionReconciliationState

  leaseOwner     String?
  leaseTokenHash String?
  leaseExpiresAt DateTime?
  revision       Int       @default(0)

  transportIdentityVersion  Int
  transportIdempotencyKey   String
  finalOutcomeCode          String?
  safeResultSummaryJson     Json?
  userExplanationCode       String?
  userExplanationParamsJson Json?
  firstAttemptedAt          DateTime?
  finalizedAt               DateTime?
  payloadRetentionUntil     DateTime?
  auditRetentionUntil       DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  tenant                Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentTask             AgentTask?         @relation(fields: [agentTaskId, tenantId], references: [id, tenantId], onDelete: Restrict)
  actorMembership       Membership?        @relation("ActionActor", fields: [actorUserId, tenantId], references: [userId, tenantId], onDelete: Restrict)
  approverMembership    Membership?        @relation("ActionApprover", fields: [approvalDecidedByUserId, tenantId], references: [userId, tenantId], onDelete: Restrict)
  attempts              ActionAttempt[]
  communicationCampaign MarketingCampaign?
  billingPayment        BillingPayment?    @relation("BillingPaymentActionExecution")
  loyaltyTransactions   LoyaltyTransaction[] @relation("LoyaltyTransactionActionExecution")
  issuedLoyaltyRedemptionGrant LoyaltyRedemptionGrant? @relation("LoyaltyRedemptionGrantIssueExecution")
  loyaltyRedemption     LoyaltyRedemption? @relation("LoyaltyRedemptionActionExecution")
  loyaltyGrantRevocation LoyaltyRedemptionGrantRevocation? @relation("LoyaltyRedemptionGrantRevocationActionExecution")
  resolvedClientIdentityHolds UnresolvedClientIdentityHold[] @relation("UnresolvedClientIdentityHoldResolutionExecution")
  createdCustomerReferral CustomerReferral? @relation("CustomerReferralCreateExecution")
  resolvedCustomerReferral CustomerReferral? @relation("CustomerReferralResolutionExecution")
  referralRewardIssuance ReferralRewardIssuance? @relation("ReferralRewardIssuanceActionExecution")
  referralRewardFulfillment ReferralRewardFulfillment? @relation("ReferralRewardFulfillmentActionExecution")
  activatedCustomerSubscription CustomerSubscription? @relation("CustomerSubscriptionActivationExecution")
  endedCustomerSubscription CustomerSubscription? @relation("CustomerSubscriptionEndExecution")
  customerSubscriptionUsages CustomerSubscriptionUsage[] @relation("CustomerSubscriptionUsageActionExecution")
  issuedGiftCertificate GiftCertificate? @relation("GiftCertificateIssueExecution")
  giftCertificateRedemption GiftCertificateRedemption? @relation("GiftCertificateRedemptionActionExecution")
  expense               Expense?           @relation("ExpenseActionExecution")
  expensePeriodDeclaration ExpensePeriodDeclaration? @relation("ExpensePeriodDeclarationActionExecution")
  invalidatedExpensePeriodDeclarations ExpensePeriodDeclarationInvalidation[] @relation("ExpensePeriodInvalidatedDeclarationExecution")
  expensePeriodDeclarationInvalidations ExpensePeriodDeclarationInvalidation[] @relation("ExpensePeriodInvalidationExecution")
  tenantCatalogItemValueVersion TenantCatalogItemValueVersion? @relation("TenantCatalogItemValueVersionActionExecution")
  referralProgramValueVersion ReferralProgramValueVersion? @relation("ReferralProgramValueVersionActionExecution")
  actionTargetMutations       ActionTargetMutation[]
  operationalWorkItemsCreated OperationalWorkItem[] @relation("OperationalWorkItemCreateExecution")
  operationalWorkItemsCompleted OperationalWorkItem[] @relation("OperationalWorkItemCompleteExecution")
  clientConsentFacts          ClientConsentFact[]
  wantedSlotInterestsCreated  ClientWantedSlotInterest[] @relation("ClientWantedSlotCreateExecution")
  wantedSlotInterestsMutated  ClientWantedSlotInterest[] @relation("ClientWantedSlotMutationExecution")
  maintenanceRuns             MaintenanceRun[]
  idempotencyBindings          ActionExecutionIdempotencyBinding[]

  @@unique([id, tenantId])
  @@unique([tenantId, identityFingerprint])
  @@unique([tenantId, idempotencyScope, requestIdempotencyKeyHash], map: "ActionExecution_tenant_idempotency_key")
  @@unique([tenantId, ownerReportRunId, ownerReportSlotKey], map: "B36_execution_slot_key")
  @@index([tenantId, state, nextExecutionAttemptAt])
  @@index([tenantId, reconciliationState, leaseExpiresAt])
  @@index([tenantId, agentTaskId])
  @@index([tenantId, createdAt])

  // Wave R-C Option A: approved owner bindings and relations.
  operationalAlertRunId String?
  operationalAlertSlotKey String?
  nativeFeedbackRequestId String?
  nativeFeedbackRevisionId String?
  nativeFeedbackSlotKey String?
  teamMessageId String?
  teamMessageSlotKey String?
  expenseReminderRunId String?
  expenseReminderSlotKey String?
  @@unique([tenantId, operationalAlertRunId, operationalAlertSlotKey], map: "R06_execution_slot_uq")
  operationalAlertRun OperationalAlertRun? @relation("R06_execution_run", fields: [operationalAlertRunId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict, map: "R06_execution_run_fk")
  ownedNativeFeedbackRequests NativeFeedbackRequest[] @relation("R08_request_execution")
  ownedNativeFeedbackRevisions NativeFeedbackRevision[] @relation("R08_revision_execution")
  @@unique([tenantId, nativeFeedbackRequestId, nativeFeedbackSlotKey], map: "R08_execution_slot_uq")
  nativeFeedbackRequest NativeFeedbackRequest? @relation("R08_execution_request", fields: [nativeFeedbackRequestId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict, map: "R08_execution_request_fk")
  nativeFeedbackRevision NativeFeedbackRevision? @relation("R08_execution_revision", fields: [nativeFeedbackRevisionId, tenantId, nativeFeedbackRequestId], references: [id, tenantId, requestId], onDelete: Restrict, onUpdate: Restrict, map: "R08_execution_revision_fk")
  communityReplies PublicCommunityComment[] @relation("R09_comment_creation")
  moderatedCommunityComments PublicCommunityComment[] @relation("R09_comment_moderation")
  businessConfigurationRevision TenantBusinessConfigurationRevision[] @relation("R11_config_execution")
  reservedTeamAttachments TeamAttachment[] @relation("R12_attachment_reserve")
  finalizedTeamAttachments TeamAttachment[] @relation("R12_attachment_finalize")
  sentTeamMessage TeamMessage[] @relation("R12_message_send")
  withdrawnTeamMessage TeamMessage[] @relation("R12_message_withdraw")
  @@unique([tenantId, teamMessageId, teamMessageSlotKey], map: "R12_execution_slot_uq")
  teamMessage TeamMessage? @relation("R12_execution_message", fields: [teamMessageId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict, map: "R12_execution_message_fk")
  @@unique([tenantId, expenseReminderRunId, expenseReminderSlotKey], map: "R13_execution_slot_uq")
  expenseReminderRun ExpenseReminderRun? @relation("R13_execution_reminder", fields: [expenseReminderRunId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict, map: "R13_execution_reminder_fk")
  expenseIntakeBindings ExpenseIntakeBinding[] @relation("R13_intake_slot")
  cashDeclaration CashDeclaration[] @relation("R14_cash_execution")
}

/// B31: every accepted caller alias is immutable and tenant/Client qualified.
/// Intent and execution lifecycle remain owned by ActionExecution.
model ActionExecutionIdempotencyBinding {
  tenantId                  String
  clientId                  String
  idempotencyScope          String
  requestIdempotencyKeyHash  String
  actionExecutionId         String
  createdAt                 DateTime @default(now())

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client    Client          @relation(fields: [clientId, tenantId], references: [id, tenantId], onDelete: Restrict)
  execution ActionExecution @relation(fields: [actionExecutionId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@id([tenantId, idempotencyScope, requestIdempotencyKeyHash])
  @@index([actionExecutionId, tenantId])
  @@index([clientId, tenantId])
}

/// Immutable-after-finish ledger entry for execution and reconciliation work.
/// A retry remains an attempt under the same logical ActionExecution.
model ActionAttempt {
  measurementRevisions MeasurementRevision[] @relation("C7ActionAttemptMeasurement")
  id                          String                @id @default(uuid())
  tenantId                    String
  actionExecutionId           String
  attemptNumber               Int
  kind                        ActionAttemptKind
  state                       ActionAttemptState
  executorKey                 String
  executorVersion             Int
  externalDispatchState       ExternalDispatchState
  providerRequestIdentityHash String?
  providerReferenceEncrypted  String?
  providerReferenceHash       String?
  transportCode               String?
  httpStatus                  Int?
  errorClass                  String?
  outcomeCode                 String?
  safeResultJson              Json?
  retryDecisionCode           String?
  reconciliationRequired      Boolean               @default(false)
  startedAt                   DateTime              @default(now())
  finishedAt                  DateTime?
  createdAt                   DateTime              @default(now())

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  execution ActionExecution @relation(fields: [actionExecutionId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([tenantId, actionExecutionId, attemptNumber])
  @@index([tenantId, state, startedAt])
  @@index([tenantId, providerReferenceHash])
}

/// Immutable proof of the exact domain-target generation committed by one
/// governed Package 5 action. It stores only internal references and safe
/// normalized hashes; raw PII, credentials, tokens and provider payloads are
/// forbidden by contract.
model ActionTargetMutation {
  id                String   @id @default(uuid())
  tenantId          String
  actionExecutionId String
  mutationKey       String
  targetKind        String
  targetRef         String
  mutationKind      String
  targetGeneration  Int
  beforeStateHash   String?
  afterStateHash    String?
  createdAt         DateTime @default(now())

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  execution ActionExecution @relation(fields: [actionExecutionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, actionExecutionId, mutationKey])
  @@unique([tenantId, targetKind, targetRef, targetGeneration])
  @@index([tenantId, targetKind, targetRef, createdAt])
  @@index([tenantId, actionExecutionId])
}

/// Tenant-wide transactional appointment reminder policy. These notices are
/// operational, not marketing: delivery is limited to the authenticated MAYA
/// account whose phone exactly matches the CRM appointment.
model AppointmentNotificationSetting {
  id               String   @id @default(cuid())
  tenantId         String   @unique
  enabled          Boolean  @default(true)
  leadTimesMinutes Json     @default("[1440,120]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([enabled])
}

/// Persisted white-label BrandingConfig. The database model name is retained
/// during the compatibility phase so existing Prisma calls keep working.
model BrandingSettings {
  id                   String   @id @default(cuid())
  tenantId             String   @unique
  logoUrl              String?
  iconUrl              String?
  faviconUrl           String?
  appName              String?
  primaryColor         String?
  secondaryColor       String?
  accentColor          String?
  backgroundColor      String?
  surfaceColor         String?
  textPrimaryColor     String?
  textSecondaryColor   String?
  backgroundImageUrl   String?
  fontFamily           String?
  headingFontFamily    String?
  buttonRadius         Int?
