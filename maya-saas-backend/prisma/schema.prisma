  @@index([branchId])
  /// Вход по почте ищет пользователя ПО ВСЕМ арендаторам, поэтому составные
  /// ключи с ведущим tenantId для него непригодны — без этих двух индексов
  /// каждая попытка входа сканирует таблицу целиком.
  @@index([email])
  @@index([phone])
}

/// Карта слияния дублей аккаунта.
///
/// Дубли появлялись, когда соц-вход не находил рабочий аккаунт и заводил
/// человеку второй, клиентский. Слияние переносит владение на рабочий аккаунт
/// и гасит дубль статусом UserStatus.merged — БЕЗ физического удаления, иначе
/// каскады по Membership унесли бы визиты, баллы и согласия.
///
/// @@unique([tenantId, duplicateUserId]) — замок идемпотентности: повторный
/// commit не создаёт вторую запись, а возвращает исходный отчёт.
/// Внешних ключей на User намеренно нет: карта обязана пережить любое будущее
/// удаление пользователя, иначе обезличится ровно тогда, когда понадобится.
model UserMerge {
  id              String   @id @default(cuid())
  tenantId        String
  primaryUserId   String
  duplicateUserId String
  actorUserId     String?
  /// Чем доказано, что это один человек: identity_email | identity_phone |
  /// primary_login_email_digits | operator_bearer_primary
  evidence        String
  /// Счётчики перенесённого и id — без персональных данных.
  reportJson      Json
  createdAt       DateTime @default(now())
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, duplicateUserId])
  @@index([tenantId, primaryUserId])
}

model Membership {
  measurementRevisions MeasurementRevision[] @relation("C7MembershipMeasurement")
  id                             String                       @id @default(cuid())
  tenantId                       String
  userId                         String
  branchId                       String?
  role                           UserRole
  status                         MembershipStatus             @default(active)
  invitedAt                      DateTime?
  joinedAt                       DateTime?
  createdAt                      DateTime                     @default(now())
  updatedAt                      DateTime                     @updatedAt
  tenant                         Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                           User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch                         Branch?                      @relation(fields: [branchId, tenantId], references: [id, tenantId], onDelete: Restrict)
  authIdentities                 AuthIdentity[]               @relation("AuthIdentityMembership")
  authSessions                   AuthSession[]                @relation("AuthSessionMembership")
  internalProviders              InternalProvider[]           @relation("InternalProviderMembership")
  customerProfile                CustomerProfile?             @relation("CustomerProfileMembership")
  loyaltyAccount                 LoyaltyAccount?              @relation("LoyaltyAccountMembership")
  dashboardPreferences           DashboardPreference[]
  aiBrainSessions                AiBrainSession[]
  aiMemoryFacts                  AiMemoryFact[]
  actionExecutionsAsActor        ActionExecution[]            @relation("ActionActor")
  actionExecutionsAsApprover     ActionExecution[]            @relation("ActionApprover")
  communicationCampaignsCreated  MarketingCampaign[]          @relation("CommunicationCreator")
  communicationCampaignsApproved MarketingCampaign[]          @relation("CommunicationApprover")
  communicationRecipients        MarketingCampaignRecipient[] @relation("CommunicationRecipientMembership")
  operationalWorkItemsAssigned   OperationalWorkItem[] @relation("OperationalWorkItemAssignee")
  operationalWorkItemsCreated    OperationalWorkItem[] @relation("OperationalWorkItemCreator")
  clientConsentFactsAsActor      ClientConsentFact[] @relation("ClientConsentActor")

  @@unique([userId, tenantId])
  @@index([tenantId, status])
  @@index([userId, status])
  @@index([tenantId, branchId])

  // Wave R-C Option A: approved owner bindings and relations.
  @@unique([id, tenantId], map: "Membership_id_tenantId_key")
  nativeFeedbackRequests NativeFeedbackRequest[] @relation("R08_request_member")
  businessConfigurationRevisions TenantBusinessConfigurationRevision[] @relation("R11_config_member")
  teamAttachments TeamAttachment[] @relation("R12_attachment_member")
  sentTeamMessages TeamMessage[] @relation("R12_message_sender")
  withdrawnTeamMessages TeamMessage[] @relation("R12_message_withdrawer")
  expenseIntakeBindings ExpenseIntakeBinding[] @relation("R13_intake_member")
  cashDeclarations CashDeclaration[] @relation("R14_cash_member")
}

/// Personal dashboard layout and targets for one membership. Preferences are
/// tenant-scoped so the same MAYA account can configure each business safely.
model DashboardPreference {
  id         String     @id @default(cuid())
  tenantId   String
  userId     String
  section    String     @default("finance")
  configJson Json       @default("{}")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [userId, tenantId], references: [userId, tenantId], onDelete: Cascade)

  @@unique([userId, tenantId, section])
  @@index([tenantId, section])
}

/// Tenant-scoped link between a CRM staff record and MAYA access. A role can
/// be prepared before a login is created; userId is attached only when the
/// owner supplies a verified login channel for that staff member.
model CrmStaffAccess {
  id                   String               @id @default(cuid())
  tenantId             String
  externalStaffId      String
  userId               String?
  encryptedDisplayName String
  title                String?
  role                 UserRole
  status               CrmStaffAccessStatus @default(pending_contact)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                 User?                @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// 🔴 Phase A. Грант доступа переезжает на идентичность Maya. Пока nullable:
  /// NOT NULL ставится только на CUTOVER, после доказанного backfill.
  staffId String?
  staff   Staff?  @relation(fields: [staffId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([staffId, tenantId])
  /// НАСЛЕДИЕ: снимается на CUTOVER, не раньше.
  @@unique([tenantId, externalStaffId])
  @@unique([tenantId, userId])
  @@index([tenantId, role, status])
  @@index([userId])
  @@index([staffId])
}

