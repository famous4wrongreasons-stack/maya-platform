/// Область действия записи аудита.
///
/// Различие ЗАЯВЛЯЕТСЯ, а не выводится из того, заполнена ли колонка
/// арендатора. Платформенное действие (вход владельца платформы, создание или
/// удаление арендатора) не принадлежит никакому арендатору, и подделывать ему
/// принадлежность через служебного арендатора нельзя: тогда платформенные
/// записи попали бы в историю чужого салона.
enum AuditScope {
  tenant
  platform
}

/// Идентичность клиента внутри Maya.
///
/// 🔴 До этого её не существовало вовсе: внешний id клиента адаптер вычислял и
/// ВЫБРАСЫВАЛ, а единственным ключом сопоставления был телефон. Отсюда три
/// следствия — смена номера рвала историю атрибуции (subjectRef считается от
/// телефона), дубли карточек в CRM были неразрешимы, а смена CRM обнуляла
/// связь с прошлым.
///
/// Якорь намеренно почти пустой: имя, визиты, суммы и прайс остаются во внешней
/// системе. Вторую CRM внутри Maya не строим. Личность существует и для гостя
/// без аккаунта — таких в салоне большинство.
model Client {
  measurementRevisions MeasurementRevision[] @relation("C7ClientMeasurement")
  consentInvalidations ClientConsentInvalidation[]
  bulkAudienceMembers MarketingAudienceRecipient[]
  bulkRecipients MarketingCampaignRecipient[]
  bookingConfirmations ClientBookingConfirmation[]
  actionIdempotencyBindings ActionExecutionIdempotencyBinding[]
  id                 String   @id @default(cuid())
  tenantId           String
  /// Аккаунт Maya, если человек им обзавёлся.
  userId             String?
  /// HMAC от последних десяти цифр номера — того же ключа, по которому идёт всё
  /// сопоставление сегодня. Сам номер здесь не хранится.
  ///
  /// НЕ идентичность и НЕ уникален: семья на один номер — обычное дело, и
  /// склеивать таких людей нельзя. Это индекс кандидатов, не более.
  phoneHash          String?
  /// Терминальное состояние погашенного дубля, как UserStatus.merged.
  mergedIntoClientId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// 🔴 Ссылка СОСТАВНАЯ. Одноколоночная позволяла погасить клиента в пользу
  /// клиента ЧУЖОГО арендатора — межарендное слияние на уровне базы.
  mergedInto   Client?         @relation("ClientMerge", fields: [mergedIntoClientId, tenantId], references: [id, tenantId], onDelete: NoAction, onUpdate: NoAction)
  mergedFrom   Client[]        @relation("ClientMerge")
  crmLinks     CrmClientLink[]
  appointments Appointment[]
  loyaltyAccounts LoyaltyAccount[]
  loyaltyRedemptionGrants LoyaltyRedemptionGrant[]
  referralsAsReferrer CustomerReferral[] @relation("ReferralReferrer")
  referralsAsReferred CustomerReferral[] @relation("ReferralReferredClient")
  referralRewards ReferralReward[] @relation("ReferralRewardRecipient")
  customerSubscriptions CustomerSubscription[]
  customerProfiles CustomerProfile[]
  consentFacts ClientConsentFact[]
  channelLinks ClientChannelLink[]
  linkChallenges ClientLinkChallenge[]
  wantedSlotInterests ClientWantedSlotInterest[]
  webPushEndpoints ClientWebPushEndpoint[]

  @@unique([id, tenantId])
  @@index([tenantId, phoneHash])
  @@index([tenantId, userId])

  // Wave R-C Option A: approved owner bindings and relations.
  nativeFeedbackRequests NativeFeedbackRequest[] @relation("R08_request_client")
  nativeFeedbackRevisions NativeFeedbackRevision[] @relation("R08_revision_client")
}

/// Привязка карточки внешней CRM к идентичности Maya.
///
/// Провайдер входит в ключ намеренно: без него смена CRM отдала бы историю
/// чужой карточке с совпавшим номером.
model CrmClientLink {
  id         String    @id @default(cuid())
  tenantId   String
  clientId   String
  provider   String
  externalId String
  /// Когда карточку в последний раз видели живой в CRM.
  syncedAt   DateTime  @default(now())
  /// Карточка исчезла или заархивирована во внешней системе. Строка ОСТАЁТСЯ:
  /// история Maya не должна пропадать вместе с записью провайдера.
  unlinkedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Составной ключ: строка связи не может указывать на клиента другого
  /// арендатора. То самое правило миграции strict_tenant_relations.
  client Client @relation(fields: [clientId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([tenantId, provider, externalId])
  @@index([tenantId, clientId])
  @@index([tenantId, provider, syncedAt])
}

/// Approved A18 V1: one verified binding episode, independent of Maya User.
/// Active subject uniqueness and immutable verification history are enforced
/// by the additive PostgreSQL migration, including a partial unique index.
model ClientChannelLink {
  consentInvalidations ClientConsentInvalidation[]
  bookingConfirmations ClientBookingConfirmation[]
  id                       String   @id @default(uuid())
  tenantId                 String
  clientId                 String
  provider                 String
  providerSubjectHash      String
  deliveryAddressEncrypted String?
  subjectHashVersion       Int      @default(1)
  verificationMethod       String
  verificationVersion      Int      @default(1)
  verificationIdentityHash String
  verificationEvidenceJson Json
  verificationEvidenceHash String
  verifiedAt               DateTime @default(dbgenerated("timezone('UTC'::text, CURRENT_TIMESTAMP)"))
  createdAt                DateTime @default(dbgenerated("timezone('UTC'::text, CURRENT_TIMESTAMP)"))
  supersedesLinkId          String?  @unique
  revokedAt                DateTime?
  revocationIdentityHash   String?
  revocationEvidenceJson   Json?
  revocationEvidenceHash   String?

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  client     Client             @relation(fields: [clientId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  predecessor ClientChannelLink? @relation("ClientChannelLinkHistory", fields: [supersedesLinkId, tenantId, provider, providerSubjectHash], references: [id, tenantId, provider, providerSubjectHash], onDelete: Restrict, onUpdate: Restrict, map: "ClientChannelLink_predecessor_fkey")
  successors ClientChannelLink[] @relation("ClientChannelLinkHistory")
  consumedChallenges ClientLinkChallenge[] @relation("ClientLinkChallengeOutcome")
  wantedSlotInterests ClientWantedSlotInterest[]
  webPushEndpoints ClientWebPushEndpoint[]

  @@unique([id, tenantId])
  @@unique([id, tenantId, clientId], map: "ClientChannelLink_client_reference_key")
  @@unique([id, tenantId, provider, providerSubjectHash], map: "ClientChannelLink_identity_reference_key")
  @@unique([tenantId, verificationIdentityHash], map: "ClientChannelLink_verification_identity_key")
  @@unique([tenantId, revocationIdentityHash], map: "ClientChannelLink_revocation_identity_key")
  @@index([tenantId, clientId])
}

/// B24 V1: immutable encrypted delivery episode, never Client identity.
/// SQL guards enforce verified ownership, terminal lifecycle and the active cap.
model ClientWebPushEndpoint {
  id                       String    @id @default(uuid())
  tenantId                 String
  clientId                 String
  clientChannelLinkId      String
  endpointHash             String
  hashVersion              Int       @default(1)
  subscriptionEncrypted    String
  materialHash             String
  registrationIdentityHash String
  policyVersion            Int       @default(1)
  createdAt                DateTime  @default(dbgenerated("timezone('UTC'::text, CURRENT_TIMESTAMP)"))
  registrationEvidenceJson Json
  registrationEvidenceHash String
  supersedesEndpointId     String?   @unique
  endedAt                  DateTime?
  endReason                String?
  terminationIdentityHash  String?   @unique
  terminationEvidenceJson  Json?
  terminationEvidenceHash  String?

  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  client            Client                  @relation(fields: [clientId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  clientChannelLink ClientChannelLink       @relation(fields: [clientChannelLinkId, tenantId, clientId], references: [id, tenantId, clientId], onDelete: Restrict, onUpdate: Restrict)
  predecessor       ClientWebPushEndpoint?  @relation("WebPushEpisode", fields: [supersedesEndpointId, tenantId, clientId], references: [id, tenantId, clientId], onDelete: Restrict, onUpdate: Restrict)
  successors        ClientWebPushEndpoint[] @relation("WebPushEpisode")

  @@unique([id, tenantId, clientId])
  @@unique([tenantId, registrationIdentityHash])
  @@index([tenantId, clientId, endedAt, createdAt, id])
  @@index([endpointHash])
}

/// Approved after 84696bc9: Client-bound, single-use challenge; TTL V1 = 600s.
/// Immutable issuance and correlated atomic consumption are guarded in SQL.
model ClientLinkChallenge {
  id                   String   @id @default(uuid())
  tenantId             String
  clientId             String
  tokenHash            String
  tokenHashVersion     Int      @default(1)
  policyVersion        Int      @default(1)
  issuedAt             DateTime @default(dbgenerated("timezone('UTC'::text, CURRENT_TIMESTAMP)"))
  expiresAt            DateTime
  issuanceEvidenceJson Json
  issuanceEvidenceHash String
  consumedAt           DateTime?
  consumedLinkId       String?  @unique
  consumedProvider     String?
  consumedSubjectHash  String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  client Client @relation(fields: [clientId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  consumedLink ClientChannelLink? @relation("ClientLinkChallengeOutcome", fields: [consumedLinkId, tenantId, consumedProvider, consumedSubjectHash], references: [id, tenantId, provider, providerSubjectHash], onDelete: Restrict, onUpdate: Restrict, map: "ClientLinkChallenge_outcome_fkey")

  @@unique([id, tenantId])
  @@unique([tenantId, tokenHash])
  @@index([tenantId, clientId])
  @@index([tenantId, expiresAt])
}

/// Мастер салона глазами Maya — идентичность, не зависящая ни от подключённой
/// CRM, ни от наличия аккаунта.
///
/// 🔴 До этой модели идентичность мастера существовала ДВАЖДЫ: InternalProvider
/// для внутреннего календаря и CrmStaffAccess.externalStaffId для CRM. Второе
/// вдобавок было ключом выдачи роли и отзыва сессий, то есть правом входа
/// распоряжался идентификатор из чужой системы.
///
/// Различитель источников — не поле, а структура: у внутреннего мастера НЕТ ни
/// одной StaffProviderLink.
model Staff {
  measurementRevisions MeasurementRevision[] @relation("C7StaffMeasurement")
  id                   String   @id @default(cuid())
  tenantId             String
  /// Аккаунт Maya, если человек им обзавёлся.
  ///
  /// 🔴 SetNull, а не Cascade (в отличие от InternalProvider): идентичность
  /// мастера переживает удаление аккаунта, иначе вместе с ним уходит история.
  ///
  /// 🔴 Связи с Membership здесь СОЗНАТЕЛЬНО нет — как и у Client. Составной FK
  /// на Membership(userId, tenantId) даёт ON DELETE CASCADE, то есть снятие
  /// членства стирало бы саму идентичность мастера вместе с его историей.
  /// Принадлежность арендатору держит tenantId и @@unique([tenantId, userId]);
  /// членство проверяет приложение.
  userId               String?
  branchId             String?
  /// Имя шифруется ВСЕГДА. InternalProvider хранил его открытым, CrmStaffAccess
  /// зашифрованным; объединение поднимает планку до строгой из двух.
  ///
  /// Phase A: nullable, потому что шифровать средствами Postgres нечем — ключ у
  /// приложения. Заполняется backfill-скриптом, NOT NULL ставится на CUTOVER.
  encryptedDisplayName String?
  title                String?
  specialization       String?
  avatarUrl            String?
  active               Boolean  @default(true)
  /// Шаг сетки записи — свойство внутреннего календаря.
  slotIntervalMinutes  Int      @default(30)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  branch        Branch?             @relation(fields: [branchId, tenantId], references: [id, tenantId], onDelete: Restrict)
  providerLinks StaffProviderLink[]
  accessGrant   CrmStaffAccess?
  appointments  Appointment[]
  wantedSlotInterests ClientWantedSlotInterest[]

  /// 🔴 Цель составных внешних ключей: ссылка не может указать на мастера
  /// чужого арендатора.
  @@unique([id, tenantId])
  @@unique([tenantId, userId])
  @@index([tenantId, active])
  @@index([branchId])
}

/// Связь мастера Maya с его карточкой у провайдера. Зеркало CrmClientLink.
model ClientWantedSlotInterest {
  id                            String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  tenantId                      String
  clientId                      String
  branchId                      String
  staffId                       String
  desiredStartAt                DateTime
  expiresAt                     DateTime  @default(dbgenerated("timezone('UTC'::text, CURRENT_TIMESTAMP)"))
  matchToleranceMinutes         Int       @default(0)
  status                        String    @default("ACTIVE")
  createdByActionExecutionId    String
  lastMutationActionExecutionId String?
  sourceChannelLinkId           String
  matchedSourceEventId          String?
  matchedAt                     DateTime?
  notifiedAt                    DateTime?
  terminalAt                    DateTime?
  createdAt                     DateTime  @default(dbgenerated("timezone('UTC'::text, CURRENT_TIMESTAMP)"))
  updatedAt                     DateTime  @updatedAt

  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "ClientWantedSlotInterest_tenant_fkey")
  client                Client            @relation(fields: [clientId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict, map: "ClientWantedSlotInterest_client_fkey")
  branch                Branch            @relation(fields: [branchId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict, map: "ClientWantedSlotInterest_branch_fkey")
  staff                 Staff             @relation(fields: [staffId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict, map: "ClientWantedSlotInterest_staff_fkey")
  sourceChannelLink     ClientChannelLink @relation(fields: [sourceChannelLinkId, tenantId, clientId], references: [id, tenantId, clientId], onDelete: Restrict, onUpdate: Restrict, map: "ClientWantedSlotInterest_channel_fkey")
  createdByExecution    ActionExecution   @relation("ClientWantedSlotCreateExecution", fields: [createdByActionExecutionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict, map: "ClientWantedSlotInterest_create_execution_fkey")
  lastMutationExecution ActionExecution?  @relation("ClientWantedSlotMutationExecution", fields: [lastMutationActionExecutionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict, map: "ClientWantedSlotInterest_mutation_execution_fkey")

  @@unique([id, tenantId])
  @@unique([tenantId, createdByActionExecutionId], map: "ClientWantedSlotInterest_tenant_createExecution_key")
  @@unique([tenantId, lastMutationActionExecutionId], map: "ClientWantedSlotInterest_tenant_mutationExecution_key")
