// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                    String            @id @default(cuid())
  name                  String
  slug                  String            @unique
  status                String            @default("trial")
  planId                String?
  allowSelfRegistration Boolean           @default(true)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  plan                  SubscriptionPlan? @relation(fields: [planId], references: [id])
  brandingSettings      BrandingSettings?
  branches              Branch[]
  users                 User[]
  crmIntegration        CrmIntegration?
  auditLogs             AuditLog[]
  appointments          Appointment[]
  phoneAuthCodes        PhoneAuthCode[]
}

model BrandingSettings {
  id                 String   @id @default(cuid())
  tenantId           String   @unique
  logoUrl            String?
  appName            String?
  primaryColor       String?
  secondaryColor     String?
  backgroundImageUrl String?
  fontFamily         String?
  buttonRadius       Int?
  themeJson          Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Branch {
  id           String        @id @default(cuid())
  tenantId     String
  name         String
  address      String?
  phone        String?
  timezone     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users        User[]
  appointments Appointment[]

  @@index([tenantId])
}

model User {
  id           String        @id @default(cuid())
  tenantId     String?
  branchId     String?
  email        String
  phone        String?
  passwordHash String
  role         String
  status       String        @default("active")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tenant       Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  auditLogs    AuditLog[]
  appointments Appointment[] @relation("ClientAppointments")

  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([branchId])
}

model PhoneAuthCode {
  id         String   @id @default(cuid())
  tenantId   String
  phone      String
  codeHash   String
  attempts   Int      @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, phone])
  @@index([tenantId, expiresAt])
}

model CrmIntegration {
  id                String   @id @default(cuid())
  tenantId          String   @unique
  provider          String
  encryptedApiToken String
  baseUrl           String?
  status            String   @default("active")
  settingsJson      Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model SubscriptionPlan {
  id                  String   @id @default(cuid())
  name                String   @unique
  priceMonthly        Int
  maxBranches         Int
  maxStaff            Int
  featuresJson        Json?
  isWhiteLabelEnabled Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  tenants             Tenant[]
}

model AuditLog {
  id           String   @id @default(cuid())
  tenantId     String
  userId       String?
  action       String
  entityType   String
  entityId     String
  metadataJson Json?
  createdAt    DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
}

model Appointment {
  id              String   @id @default(cuid())
  tenantId        String
  clientId        String
  branchId        String?
  crmExternalId   String?
  staffExternalId String
  serviceIds      Json
  startAt         DateTime
  status          String   @default("confirmed")
  notes           String?
  providerPayload Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client          User     @relation("ClientAppointments", fields: [clientId], references: [id], onDelete: Cascade)
  branch          Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([clientId])
  @@index([branchId])
}
