  clientChannelLink ClientChannelLink @relation(fields: [clientChannelLinkId, tenantId, clientId], references: [id, tenantId, clientId], onDelete: Restrict, onUpdate: Restrict, map: "ClientBookingConfirmation_link_fkey")

  @@index([tenantId, clientId])
}

/// B36 immutable staff/business report. Delivery state belongs to existing A12 executions.
