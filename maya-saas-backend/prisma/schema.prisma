/// Область действия записи аудита.
///
/// Различие ЗАЯВЛЯЕТСЯ, а не выводится из того, заполнена ли колонка
/// арендатора. Платформенное действие (вход владельца платформы, создание или
/// удаление арендатора) не принадлежит никакому арендатору, и подделывать ему
/// принадлежность через служебного арендатора нельзя: тогда платформенные
/// записи попали бы в историю чужого салона.
enum AuditScope {
  tenant
  platform
}

/// Идентичность клиента внутри Maya.
///
/// 🔴 До этого её не существовало вовсе: внешний id клиента адаптер вычислял и
/// ВЫБРАСЫВАЛ, а единственным ключом сопоставления был телефон. Отсюда три
/// следствия — смена номера рвала историю атрибуции (subjectRef считается от
/// телефона), дубли карточек в CRM были неразрешимы, а смена CRM обнуляла
/// связь с прошлым.
///
/// Якорь намеренно почти пустой: имя, визиты, суммы и прайс остаются во внешней
/// системе. Вторую CRM внутри Maya не строим. Личность существует и для гостя
/// без аккаунта — таких в салоне большинство.
model Client {
  id                 String   @id @default(cuid())
  tenantId           String
  /// Аккаунт Maya, если человек им обзавёлся.
  userId             String?
  /// HMAC от последних десяти цифр номера — того же ключа, по которому идёт всё
  /// сопоставление сегодня. Сам номер здесь не хранится.
  ///
  /// НЕ идентичность и НЕ уникален: семья на один номер — обычное дело, и
  /// склеивать таких людей нельзя. Это индекс кандидатов, не более.
  phoneHash          String?
  /// Терминальное состояние погашенного дубля, как UserStatus.merged.
  mergedIntoClientId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// 🔴 Ссылка СОСТАВНАЯ. Одноколоночная позволяла погасить клиента в пользу
  /// клиента ЧУЖОГО арендатора — межарендное слияние на уровне базы.
  mergedInto   Client?         @relation("ClientMerge", fields: [mergedIntoClientId, tenantId], references: [id, tenantId], onDelete: NoAction, onUpdate: NoAction)
  mergedFrom   Client[]        @relation("ClientMerge")
  crmLinks     CrmClientLink[]
  appointments Appointment[]
  loyaltyRedemptionGrants LoyaltyRedemptionGrant[]
  referralsAsReferrer CustomerReferral[] @relation("ReferralReferrer")
  referralsAsReferred CustomerReferral[] @relation("ReferralReferredClient")
  referralRewards ReferralReward[] @relation("ReferralRewardRecipient")
  customerSubscriptions CustomerSubscription[]

  @@unique([id, tenantId])
  @@index([tenantId, phoneHash])
  @@index([tenantId, userId])
}

/// Привязка карточки внешней CRM к идентичности Maya.
///
/// Провайдер входит в ключ намеренно: без него смена CRM отдала бы историю
/// чужой карточке с совпавшим номером.
model CrmClientLink {
  id         String    @id @default(cuid())
  tenantId   String
  clientId   String
  provider   String
  externalId String
  /// Когда карточку в последний раз видели живой в CRM.
  syncedAt   DateTime  @default(now())
  /// Карточка исчезла или заархивирована во внешней системе. Строка ОСТАЁТСЯ:
  /// история Maya не должна пропадать вместе с записью провайдера.
  unlinkedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Составной ключ: строка связи не может указывать на клиента другого
  /// арендатора. То самое правило миграции strict_tenant_relations.
  client Client @relation(fields: [clientId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([tenantId, provider, externalId])
  @@index([tenantId, clientId])
  @@index([tenantId, provider, syncedAt])
}

/// Мастер салона глазами Maya — идентичность, не зависящая ни от подключённой
/// CRM, ни от наличия аккаунта.
///
/// 🔴 До этой модели идентичность мастера существовала ДВАЖДЫ: InternalProvider
/// для внутреннего календаря и CrmStaffAccess.externalStaffId для CRM. Второе
/// вдобавок было ключом выдачи роли и отзыва сессий, то есть правом входа
/// распоряжался идентификатор из чужой системы.
///
/// Различитель источников — не поле, а структура: у внутреннего мастера НЕТ ни
/// одной StaffProviderLink.
model Staff {
  id                   String   @id @default(cuid())
  tenantId             String
  /// Аккаунт Maya, если человек им обзавёлся.
  ///
  /// 🔴 SetNull, а не Cascade (в отличие от InternalProvider): идентичность
  /// мастера переживает удаление аккаунта, иначе вместе с ним уходит история.
  ///
  /// 🔴 Связи с Membership здесь СОЗНАТЕЛЬНО нет — как и у Client. Составной FK
  /// на Membership(userId, tenantId) даёт ON DELETE CASCADE, то есть снятие
  /// членства стирало бы саму идентичность мастера вместе с его историей.
  /// Принадлежность арендатору держит tenantId и @@unique([tenantId, userId]);
  /// членство проверяет приложение.
  userId               String?
  branchId             String?
  /// Имя шифруется ВСЕГДА. InternalProvider хранил его открытым, CrmStaffAccess
  /// зашифрованным; объединение поднимает планку до строгой из двух.
  ///
  /// Phase A: nullable, потому что шифровать средствами Postgres нечем — ключ у
  /// приложения. Заполняется backfill-скриптом, NOT NULL ставится на CUTOVER.
  encryptedDisplayName String?
  title                String?
  specialization       String?
  avatarUrl            String?
  active               Boolean  @default(true)
  /// Шаг сетки записи — свойство внутреннего календаря.
  slotIntervalMinutes  Int      @default(30)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  branch        Branch?             @relation(fields: [branchId, tenantId], references: [id, tenantId], onDelete: Restrict)
  providerLinks StaffProviderLink[]
  accessGrant   CrmStaffAccess?
  appointments  Appointment[]

  /// 🔴 Цель составных внешних ключей: ссылка не может указать на мастера
  /// чужого арендатора.
  @@unique([id, tenantId])
  @@unique([tenantId, userId])
  @@index([tenantId, active])
  @@index([branchId])
}

/// Связь мастера Maya с его карточкой у провайдера. Зеркало CrmClientLink.
model StaffProviderLink {
  id         String    @id @default(cuid())
  tenantId   String
  staffId    String
  /// 🔴 Провайдер входит в ключ намеренно. Без него смена CRM отдала бы права
  /// нового человека старому при совпадении числового id — ровно та дыра,
  /// которую нашёл анализ гейта.
  provider   String
  externalId String
  /// Когда карточку в последний раз видели живой в составе команды.
  syncedAt   DateTime  @default(now())
  /// Карточка исчезла у провайдера или CRM отключили. Строка ОСТАЁТСЯ:
  /// история Maya не должна пропадать вместе с записью чужой системы.
  unlinkedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff  Staff  @relation(fields: [staffId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([tenantId, provider, externalId])
  @@index([tenantId, staffId])
  @@index([tenantId, provider, syncedAt])
  @@index([tenantId, provider, externalId, unlinkedAt])
}

/// Правило рассылок арендатора.
///
/// 🔴 Модель восстановлена по ФАКТИЧЕСКОЙ структуре боевой базы (цикл 02-R):
/// три миграции 14.08 были применены к проду и утеряны, файлов не существует
/// нигде. Поля, типы, значения по умолчанию и связи взяты из прода дословно.
/// Прикладной смысл по именам НЕ додумывался: ни один сервис в эту таблицу не
/// пишет, бизнес-логика маркетинга относится к главе 6.
model MarketingPolicy {
  tenantId               String   @id
  provider               String   @default("yclients_sms")
  enabled                Boolean  @default(false)
  dailyRecipientLimit    Int      @default(500)
  monthlyRecipientLimit  Int      @default(5000)
  maxCampaignRecipients  Int      @default(500)
  maxCampaignCostKopecks Int?
  createdAt              DateTime @default(now())
  updatedAt              DateTime
  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Получатель в составе аудитории. Восстановлено по боевой структуре, 02-R.
model MarketingAudienceRecipient {
  id                String            @id
  tenantId          String
  audienceId        String
  externalClientId  String
  internalUserId    String?
  eligibilityStatus String
  exclusionReason   String?
  consentSource     String?
  consentRecordedAt DateTime?
  metricsJson       Json?
  createdAt         DateTime          @default(now())
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  audience          MarketingAudience @relation(fields: [audienceId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([tenantId, audienceId, externalClientId], map: "MarketingAudienceRecipient_tenantId_audienceId_externalClientId")
  @@index([tenantId, audienceId, eligibilityStatus], map: "MarketingAudienceRecipient_tenantId_audienceId_eligibilityStatu")
}

/// Получатель в составе кампании. Восстановлено по боевой структуре, 02-R.
model MarketingCampaignRecipient {
  id                       String                      @id
  tenantId                 String
  campaignId               String
  externalClientId         String
  internalUserId           String?
  idempotencyKey           String
  status                   String                      @default("QUEUED")
  attemptCount             Int                         @default(0)
  nextAttemptAt            DateTime?
  acceptedAt               DateTime?
  deliveredAt              DateTime?
  failedAt                 DateTime?
  providerMessageId        String?
  providerStatus           String?
  lastErrorCode            String?
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime
  lifecycleVersion         Int                         @default(0)
  identityVersion          Int?
  recipientKind            String?
  recipientRefHash         String?
  contentIdentityHash      String?
  deliveryState            CommunicationDeliveryState?
  externalDispatchState    ExternalDispatchState?
  reconciliationState      ActionReconciliationState?
  eligibilityBasis         String?
  eligibilityDecision      String?
  eligibilityPolicyVersion Int?
  eligibilityEvidenceRef   String?
  eligibilityEvidenceHash  String?
  eligibilityCheckedAt     DateTime?
  consentEvidenceId        String?
  leaseOwner               String?
  leaseTokenHash           String?
  leaseExpiresAt           DateTime?
  revision                 Int                         @default(0)
  dispatchedAt             DateTime?
  responseReceivedAt       DateTime?
  unknownAt                DateTime?
  terminalAt               DateTime?
  terminalReasonCode       String?
  payloadRetentionUntil    DateTime?
  auditRetentionUntil      DateTime?
  tenant                   Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign                 MarketingCampaign           @relation(fields: [campaignId, tenantId], references: [id, tenantId], onDelete: Cascade)
  internalMembership       Membership?                 @relation("CommunicationRecipientMembership", fields: [internalUserId, tenantId], references: [userId, tenantId], onDelete: Restrict)
  consentEvidence          MarketingConsentEvidence?   @relation(fields: [consentEvidenceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  deliveryAttempts         MarketingDeliveryAttempt[]

  @@unique([id, tenantId])
  @@unique([id, tenantId, campaignId])
  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, campaignId, externalClientId], map: "MarketingCampaignRecipient_tenantId_campaignId_externalClientId")
  @@index([tenantId, campaignId, status, nextAttemptAt], map: "MarketingCampaignRecipient_tenantId_campaignId_status_nextAttem")
  @@index([tenantId, campaignId, deliveryState, nextAttemptAt])
  @@index([tenantId, reconciliationState, leaseExpiresAt])
}

/// Свидетельство согласия. Восстановлено по боевой структуре, 02-R.
model MarketingConsentEvidence {
  id               String                       @id
  tenantId         String
  externalClientId String
  channel          String
  status           String
  source           String
  evidenceRef      String?
  grantedAt        DateTime?
  revokedAt        DateTime?
  expiresAt        DateTime?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime
  tenant           Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipients       MarketingCampaignRecipient[]

  @@unique([id, tenantId])
  @@unique([tenantId, externalClientId, channel], map: "MarketingConsentEvidence_tenantId_externalClientId_channel_key")
  @@index([tenantId, channel, status])
}

/// Попытка доставки. Восстановлено по боевой структуре, 02-R.
model MarketingDeliveryAttempt {
  id                          String                      @id
  tenantId                    String
  campaignId                  String
  recipientId                 String?
  batchKey                    String
  attemptNumber               Int
  status                      String
  httpStatus                  Int?
  providerResponseCode        String?
  errorCode                   String?
  startedAt                   DateTime                    @default(now())
  completedAt                 DateTime?
  createdAt                   DateTime                    @default(now())
  lifecycleVersion            Int                         @default(0)
  kind                        ActionAttemptKind?
  state                       ActionAttemptState?
  externalDispatchState       ExternalDispatchState?
  providerRequestIdentityHash String?
  providerIdempotencyKeyHash  String?
  providerReferenceEncrypted  String?
  providerReferenceHash       String?
  outcomeCode                 String?
  retryDecisionCode           String?
  reconciliationRequired      Boolean?
  dispatchedAt                DateTime?
  responseReceivedAt          DateTime?
  payloadRetentionUntil       DateTime?
  tenant                      Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign                    MarketingCampaign           @relation(fields: [campaignId, tenantId], references: [id, tenantId], onDelete: Cascade)
  recipient                   MarketingCampaignRecipient? @relation(fields: [recipientId, tenantId, campaignId], references: [id, tenantId, campaignId], onDelete: Cascade)

  @@unique([tenantId, recipientId, attemptNumber])
  @@index([tenantId, campaignId, createdAt])
  @@index([tenantId, recipientId, attemptNumber])
  @@index([tenantId, state, startedAt])
  @@index([tenantId, providerReferenceHash])
}

model AuditLog {
  id           String     @id @default(cuid())
  /// Инвариант, который держит CHECK в базе (AuditLog_scope_tenant_check):
  ///   scope = tenant   ⟺ tenantId IS NOT NULL
  ///   scope = platform ⟺ tenantId IS NULL
  /// Состояния взаимоисключающие и исчерпывающие — третьего нет. Поэтому
  /// арендаторной записи без арендатора не существует, а платформенная не
  /// может нести tenantId и попасть в выборку салона.
  scope        AuditScope @default(tenant)
  tenantId     String?
  userId       String?
  action       String
  entityType   String
  entityId     String
  metadataJson Json?
  createdAt    DateTime   @default(now())
  /// Записи арендатора уходят вместе с ним. Платформенные переживают удаление:
  /// «платформа удалила арендатора» обязано жить дольше самого арендатора.
  tenant       Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([scope, createdAt])
  /// Журнал арендатора читается по времени, а не целиком.
  @@index([tenantId, createdAt])
}

model Appointment {
  id                String   @id @default(cuid())
  tenantId          String
  /**
   * 🔴 АККАУНТ, а не клиент бизнеса.
   * Доказано данными в B3: у всех 18 боевых визитов здесь стоял ОДИН и тот же
   * пользователь — владелец салона, потому что строка появляется, когда
   * вошедший аккаунт открывает «Мои записи». Поле отвечает на вопрос «в чьём
   * кабинете это видно», а не «кто пришёл стричься».
   * Стало опциональным: у записи салона, сделанной по телефону или с виджета,
   * аккаунта Maya нет и быть не должно. Бизнес-клиент живёт в `mayaClientId`.
   */
  clientId          String?
  /**
   * 🔴 КЛИЕНТ БИЗНЕСА — идентичность Maya из главы 2.
   * Разрешается через `CrmClientLink` по внешнему идентификатору клиента у
   * провайдера. По телефону НЕ склеивается: совпадение номера доказательством
   * тождества не является.
   * Переходное имя. Целевое состояние — переименовать аккаунтное поле в
   * `accountUserId`, а это в `clientId`; массовое переименование сейчас стоило
   * бы правок в 47 местах ради ясности, поэтому вынесено отдельным шагом.
   */
  mayaClientId      String?
  branchId          String?
  crmExternalId     String?
  /// 🔴 Cycle 03 B1. Провайдер, у которого живёт `crmExternalId`.
  ///
  /// Ключ визита обязан быть КВАЛИФИЦИРОВАН провайдером: голое равенство
  /// внешних идентификаторов уже приводило к тому, что права одного человека
  /// доставались другому (глава 2). Число `12345` у YCLIENTS и у Altegio —
  /// разные записи.
  ///
  /// Заполнено ⟺ заполнен `crmExternalId`; это держит CHECK в базе, иначе
  /// половина ключа с NULL молча отключила бы уникальность.
  crmProvider       String?
  source            String   @default("external")
  staffExternalId   String
  serviceIds        Json
  startAt           DateTime
  endAt             DateTime
  blockedStartAt    DateTime
  blockedEndAt      DateTime
  status            String   @default("confirmed")
  /**
   * 🔴 Cycle 03 B3.3. Присутствие клиента — канон главы 2
   * (`awaiting | arrived | no_show | confirmed_by_client`).
   * NULL означает «Maya НЕ получила доказанного значения»: либо не спрашивали,
   * либо провайдер поля не прислал. Это НЕ `awaiting`.
   * Различие не косметическое. `awaiting` — утверждение провайдера «отметки
   * ещё нет»; NULL — отсутствие утверждения. Смешав их, зеркало заявляло бы
   * знание, которого у него нет, а компаратор выпускал бы события о переходах,
   * которых не было. Поэтому переход NULL → значение событием не является:
   * это первое наблюдение, а не изменение.
   * Существующие 1940 строк получают NULL и наполняются первым проходом
   * сверки: значение берётся у провайдера, а миграция к сети не ходит.
   */
  attendance        String?
  notes             String?
  totalPriceKopecks Int?
  currency          String   @default("RUB")
  providerPayload   Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  /// 🔴 Phase A. Однозначная идентичность мастера внутри Maya. Пока nullable.
  staffId           String?
  staff             Staff?   @relation(fields: [staffId, tenantId], references: [id, tenantId], onDelete: Restrict)
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Удаление аккаунта не стирает факт визита салона: остаётся история бизнеса.
  client            User?    @relation("ClientAppointments", fields: [clientId], references: [id], onDelete: SetNull)
  /**
   * 🔴 Клиент бизнеса. `Restrict`, а не `SetNull`: идентичность клиента,
   * у которого есть визиты, не удаляется молча. Это сильнее сохраняет историю,
   * чем обнуление ссылки, и совпадает с правилом для мастера.
   */
  mayaClient        Client?  @relation(fields: [mayaClientId, tenantId], references: [id, tenantId], onDelete: Restrict)
  branch            Branch?  @relation(fields: [branchId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId, clientId])
  /// 🔴 Одна запись CRM — одна строка Maya. До Cycle 03 уникальности не было
  /// вовсе, а поиск шёл в пределах КЛИЕНТА: два независимых пути приёма
  /// создавали два визита на одну запись, и база этому не мешала.
  @@unique([tenantId, crmProvider, crmExternalId])
  @@index([tenantId, mayaClientId])
  @@index([tenantId, staffId, startAt])
  @@index([tenantId])
  @@index([clientId])
  @@index([branchId])
  @@index([tenantId, staffExternalId, startAt])
  /// Показ недели без фильтра по мастеру: составной выше неприменим
  /// (staffExternalId — вторая колонка), а GiST построен по blockedStartAt.
  /// Без этого читались все записи арендатора за всю историю.
  @@index([tenantId, startAt])
}

/// Канонический факт бизнеса, замеченный Maya.
///
/// 🔴 Что это НЕ такое. Не копия CRM, не сообщение получателю, не след
/// действия пользователя. Все три уже есть (`Appointment`, `InboxItem`,
/// `AuditLog`) и ни один не отвечает на вопрос «что изменилось и откуда мы это
/// знаем»: у первых двух нет даже отличия «когда произошло» от «когда узнали».
///
/// 🔴 Событие означает: Maya получила ДОСТАТОЧНОЕ ДОКАЗАТЕЛЬСТВО изменения.
/// Повторное чтение того же состояния событием не является — за это отвечает
/// `dedupFingerprint`.
model DomainEvent {
  id       String @id @default(cuid())
  tenantId String

  /// Канонический тип Maya: `appointment.created`, не `record.create`.
  type    String
  /// Версия контракта. Единственный механизм версионирования: номер живёт в
  /// колонке, а не внутри имени, иначе по нему нельзя фильтровать.
  version Int    @default(1)

  entityType     String
  /// Идентичность MAYA (`Appointment.id`, `Staff.id`, `Client.id`).
  /// Внешний идентификатор сюда не кладётся никогда.
  entityId       String
  /// Порядок в пределах одной сущности. Глобального порядка Maya не обещает.
  entitySequence Int?

  /// Когда изменилось в бизнесе. Приходит из данных источника.
  occurredAt  DateTime
  /// Когда Maya приняла доставку. Совпадающим с `occurredAt` не считается:
  /// доставки приходят пачками, а между создание и изменением записи проходят
  /// десятки минут.
  receivedAt  DateTime  @default(now())
  /// Когда обработала. Отделено от факта: провал обработки не стирает факт.
  processedAt DateTime?

  /// Откуда: `yclients`, `internal_calendar`, `legacy_bot`.
  source          String
  /// Как узнали: `webhook` | `reconciliation` | `bootstrap`.
  ingestionMethod String  @default("webhook")
  /// Ссылка на сущность у источника. ПРОВЕНАНС, а не идентичность.
  sourceRef       String?
  /// `observed_existing` — найдено при первом взгляде на уже работающий салон;
  /// `after_watch_started` — изменение после начала наблюдения.
  observation     String  @default("after_watch_started")

  /// Детерминированный отпечаток канонического состояния.
  /// 🔴 Идентификатора события провайдер не даёт (доказано в Phase A), а один
  /// timestamp отпечатком не является: два одинаковых чтения обязаны дать один
  /// ключ, иначе дедупликации нет.
  dedupFingerprint String
  /// Минимальный факт, независимый от провайдера. Сырое тело сюда не попадает.
  payload          Json

  /// `pending` | `processing` | `processed` | `failed` | `dead`.
  /// Приём и обработка — разные вещи: строка существует уже как принятый факт.
  status     String    @default("pending")
  attempts   Int       @default(0)
  leaseUntil DateTime?
  lastError  String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Дедупликация живёт в БАЗЕ и переживает перезапуск. Внутри арендатора, а не
  /// глобально: два салона с одинаковым номером записи не должны подавлять
  /// друг друга.
  @@unique([tenantId, dedupFingerprint])
  @@index([tenantId, entityType, entityId, occurredAt])
  @@index([status, leaseUntil])
  @@index([tenantId, type, occurredAt])
  @@index([tenantId, receivedAt])
}

/// Доставка, которую Maya приняла, но НЕ ПОНЯЛА.
///
/// 🔴 Почему отдельная таблица, а не статус события. У карантина нет ни типа,
/// ни сущности — значит прочитать его как факт невозможно ПО ПОСТРОЕНИЮ. Пока
/// смысл доставки неизвестен, доменного события из неё не возникает.
///
/// Повод: за неделю 221 доставка (треть потока) не распознавалась вовсе и
/// выбрасывалась молча.
model IngestionQuarantine {
  id            String   @id @default(cuid())
  /// Может быть НЕ определён: «арендатор не разрешён» — законная причина
  /// карантина, и запись об этом нужна.
  tenantId      String?
  source        String
  /// Что удалось прочитать о типе доставки (`resource`/`status`), если удалось.
  discriminator String?
  /// Детерминированный отпечаток — чтобы повтор не плодил строки.
  fingerprint   String
  receivedAt    DateTime @default(now())
  /// `unknown_discriminator` | `tenant_unresolved` | `malformed` | `unsupported`.
  reason        String
  /// МИНИМУМ для разбора: имена полей и типы, неперсональные идентификаторы.
  /// Ни имени, ни телефона, ни email — контур 152-ФЗ не ослабляется.
  diagnostic    Json?
  /// `open` | `explained` | `discarded`.
  resolution    String   @default("open")
  /// Срок хранения. Это диагностика, а не история: она обязана истекать.
  expiresAt     DateTime

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([source, fingerprint])
  @@index([receivedAt])
  @@index([expiresAt])
  @@index([tenantId, receivedAt])
  @@index([resolution, receivedAt])
}

/// Прогон сверки зеркала визитов с источником (Cycle 03 B3.3).
///
/// 🔴 Зачем отдельная таблица, если есть `CrmIntegration.lastSyncAt`. Та метка
/// отвечает на один вопрос — «когда последний раз что-то происходило», — и не
/// отвечает ни на один из нужных: за какое окно смотрели, дочитали ли до конца,
/// сколько нашли, не упало ли. Сверка, чей результат нельзя отличить от
/// усечённого или упавшего, права объявлять что-либо исчезнувшим не имеет.
///
/// 🔴 Курсора здесь нет намеренно. Окно считается от «сейчас», а последний
/// ПОЛНЫЙ проход находится запросом по этой же таблице. Состояние, которое
/// выводится из данных, но хранится отдельно, — лишний источник расхождения.
///
/// 🔴 Здесь же живёт аренда (B3.4). Инвариант «живой прогон у пары арендатор +
/// провайдер только один» держит ЧАСТИЧНЫЙ уникальный индекс, объявленный в
/// миграции `20260818120000_reconciliation_lease`:
///
///   CREATE UNIQUE INDEX "ReconciliationRun_live_run_unique"
///     ON "ReconciliationRun" ("tenantId", "provider")
///     WHERE "finishedAt" IS NULL AND "failureCode" IS NULL;
///
/// Prisma частичные индексы в схеме не выражает, поэтому он существует только
/// в SQL. Дрейфа это не создаёт — проверено `migrate diff`.
model ReconciliationRun {
  id       String @id @default(cuid())
  tenantId String
  provider String

  windowFrom DateTime
  windowTo   DateTime
  startedAt  DateTime  @default(now())
  /// NULL ⟺ прогон не завершился. Незавершённый выводов не даёт вовсе.
  finishedAt DateTime?

  /**
   * `complete` | `truncated` — контракт полноты B3.0.
   * Только `complete` двигает базовую линию наблюдения и даёт право на выводы
   * об ОТСУТСТВИИ. По усечённой выборке отсутствие записи не означает ничего:
   * её могло просто не хватить страниц.
   */
  completeness     String?
  truncationReason String?

  fetched       Int @default(0)
  created       Int @default(0)
  updated       Int @default(0)
  unchanged     Int @default(0)
  eventsEmitted Int @default(0)

  failureCode    String?
  failureMessage String?

  /**
   * 🔴 Cycle 03 B3.4. Аренда: до какого момента этот прогон считается живым.
   * Процессной переменной недостаточно, и не в будущем, а сегодня: ручной
   * запуск сверки — ОТДЕЛЬНЫЙ процесс, а во время выката старый процесс
   * дорабатывает проход, пока новый уже стартовал. Булево поле в памяти об
   * этом не знает и знать не может.
   * Аренда не снимается, а ИСТЕКАЕТ. Процесс, умерший посреди прохода, не
   * оставляет замок, который нужно снимать руками: следующий претендент видит
   * просроченную аренду, закрывает брошенный прогон как упавший и начинает
   * свой. Ручного вмешательства не требуется ни в одном сценарии.
   */
  leaseUntil DateTime?
  /// Кто держит аренду. Провенанс для разбора, не идентичность.
  holderId   String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, startedAt])
  /// Поиск последнего ПОЛНОГО завершённого прогона — его нельзя перепутать
  /// с усечённым или упавшим: оба отбираются этим же индексом по значению.
  @@index([tenantId, completeness, finishedAt])
}

/// Consent-safe outreach fact used by MAYA Recovered attribution.
/// `subjectRef` is a tenant-independent HMAC of the normalized phone; raw
/// client identity is never persisted in this subsystem.
model RecoveryTouchpoint {
  id                    String               @id @default(cuid())
  tenantId              String
  externalEventId       String
  subjectRef            String
  kind                  String
  channel               String
  status                String
  occurredAt            DateTime
  attributionWindowDays Int                  @default(30)
  createdAt             DateTime             @default(now())
  tenant                Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversions           RecoveryConversion[]

  @@unique([tenantId, externalEventId])
  @@index([tenantId, occurredAt])
  @@index([tenantId, subjectRef, occurredAt])
}

/// Booking attributed to an earlier MAYA touchpoint. Booked value and CRM
/// confirmed cash are deliberately separate so reports cannot claim forecast
/// money as received revenue.
model RecoveryConversion {
  id                      String             @id @default(cuid())
  tenantId                String
  touchpointId            String
  externalBookingRef      String
  crmExternalId           String?
  subjectRef              String
  bookedAt                DateTime
  visitAt                 DateTime?
  status                  String             @default("booked")
  filledWindow            Boolean            @default(false)
  bookedValueKopecks      Int?
  confirmedRevenueKopecks Int?
  currency                String             @default("RUB")
  confirmedAt             DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  tenant                  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  touchpoint              RecoveryTouchpoint @relation(fields: [touchpointId], references: [id], onDelete: Cascade)

  @@unique([tenantId, externalBookingRef])
  @@index([tenantId, bookedAt])
  @@index([tenantId, crmExternalId])
  @@index([tenantId, subjectRef, bookedAt])
}

/// Consent-scoped audience snapshot. Recipient ids stay server-side and are
/// never exposed to the language model or written into an approval preview.
model MarketingAudience {
  id                   String              @id @default(cuid())
  tenantId             String
  createdByUserId      String
  ruleJson             Json
  recipientUserIdsJson Json
  candidateCount       Int
  eligibleCount        Int
  unavailableCount     Int                 @default(0)
  expiresAt            DateTime
  createdAt            DateTime            @default(now())
  /// Восстановлено по фактической боевой структуре, цикл 02-R.
  provider             String              @default("yclients_sms")
  status               String              @default("AUDIENCE_CALCULATED")
  snapshotHash         String              @default("")
  exclusionReasonsJson Json                @default("{}")
  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaigns            MarketingCampaign[]

  recipients MarketingAudienceRecipient[]

  @@unique([id, tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, expiresAt])
}

/// Immutable campaign preview followed by one idempotent, owner-approved send.
/// The message is stored as business content; recipient identity remains an
/// internal user id list and is revalidated against consent before delivery.
model MarketingCampaign {
  id                          String                      @id @default(cuid())
  tenantId                    String
  createdByUserId             String?
  audienceId                  String?
  channel                     String                      @default("app")
  status                      String                      @default("draft")
  message                     String
  recipientUserIdsJson        Json
  recipientCount              Int
  sentCount                   Int                         @default(0)
  idempotencyKey              String?
  expiresAt                   DateTime
  sentAt                      DateTime?
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
  /// Двадцать две колонки восстановлены по фактической боевой структуре,
  /// цикл 02-R. Прикладной смысл по именам не додумывался.
  provider                    String                      @default("yclients_sms")
  audienceSnapshotHash        String                      @default("")
  messageSnapshotHash         String                      @default("")
  confirmationHash            String?
  confirmedAt                 DateTime?
  confirmedByUserId           String?
  costEstimateKopecks         Int?
  costEstimateStatus          String                      @default("unavailable")
  costCurrency                String                      @default("RUB")
  scheduledFor                DateTime?
  queuedAt                    DateTime?
  startedAt                   DateTime?
  completedAt                 DateTime?
  cancelledAt                 DateTime?
  leaseOwner                  String?
  leaseExpiresAt              DateTime?
  retryCount                  Int                         @default(0)
  lastErrorCode               String?
  acceptedCount               Int                         @default(0)
  failedCount                 Int                         @default(0)
  skippedCount                Int                         @default(0)
  unknownCount                Int                         @default(0)
  lifecycleVersion            Int                         @default(0)
  scope                       CommunicationScope?
  actionExecutionId           String?
  aggregateState              CommunicationCampaignState?
  contentRef                  String?
  deliveryCapabilityKey       String?
  deliveryCapabilityVersion   Int?
  retryPolicyKey              String?
  retryPolicyVersion          Int?
  reconciliationPolicyKey     String?
  reconciliationPolicyVersion Int?
  leaseTokenHash              String?
  revision                    Int                         @default(0)
  payloadRetentionUntil       DateTime?
  auditRetentionUntil         DateTime?
  tenant                      Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actionExecution             ActionExecution?            @relation(fields: [actionExecutionId, tenantId], references: [id, tenantId], onDelete: Restrict)
  audience                    MarketingAudience?          @relation(fields: [audienceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  creatorMembership           Membership?                 @relation("CommunicationCreator", fields: [createdByUserId, tenantId], references: [userId, tenantId], onDelete: Restrict)
  approverMembership          Membership?                 @relation("CommunicationApprover", fields: [confirmedByUserId, tenantId], references: [userId, tenantId], onDelete: Restrict)

  recipients MarketingCampaignRecipient[]

  deliveryAttempts MarketingDeliveryAttempt[]

  @@unique([tenantId, idempotencyKey])
  @@unique([id, tenantId])
  @@unique([actionExecutionId, tenantId])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, audienceId])
  @@index([tenantId, aggregateState, scheduledFor, leaseExpiresAt])
  @@index([status, leaseExpiresAt, queuedAt])
  @@index([status, scheduledFor, leaseExpiresAt])
}

/// Persistent in-app MAYA inbox (message of record for reports / alerts).
/// Telegram and push only announce; this row survives app restarts.
model InboxItem {
  id            String    @id @default(cuid())
  tenantId      String
  userId        String
  /// daily_report | morning_brief | growth_plan | new_appointment |
  /// shift_reminder | appointment_reassigned | hanging_lead | owner_alert
  type          String
  sourceEventId String
  title         String
  bodyText      String
  payloadJson   Json?
  deepLink      String?
  createdAt     DateTime  @default(now())
  readAt        DateTime?
  archivedAt    DateTime?
  deletedAt     DateTime?
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, type, sourceEventId])
  @@index([tenantId, userId, createdAt])
  @@index([tenantId, type, createdAt])
}

/// Native / web push device tokens for inbox announcements.
model DevicePushToken {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  /// ios | android | web
  platform  String
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, token])
  @@index([tenantId, userId])
}
