  encryptedSecretKey String
  status             String    @default("active")
  verifiedAt         DateTime?
  lastCheckedAt      DateTime?
  lastErrorCode      String?
  lastErrorAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Tenant-owned products and sellable offers. CRM/store adapters may mirror
/// their catalog here, while businesses without an adapter can manage it
/// manually. `kind` is one of inventory, certificate or membership.
model TenantCatalogItem {
  id                    String                          @id @default(cuid())
  tenantId              String
  kind                  String
  name                  String
  description           String?
  priceKopecks          Int?
  currency              String                          @default("RUB")
  quantity              Int?
  lowStockThreshold     Int?
  active                Boolean                         @default(true)
  source                String                          @default("manual")
  externalRef           String?
  metadataJson          Json?
  canonicalTemplateKey  String?
  supersedesOfferId     String?
  currentValueVersionId String?
  createdAt             DateTime                        @default(now())
  updatedAt             DateTime                        @updatedAt
  tenant                Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  valueVersions         TenantCatalogItemValueVersion[] @relation("TenantCatalogItemValueVersions")
  currentValueVersion   TenantCatalogItemValueVersion?  @relation("TenantCatalogItemCurrentValueVersion", fields: [currentValueVersionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  supersededOffer       TenantCatalogItem?               @relation("TenantCatalogItemReplacementLineage", fields: [supersedesOfferId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  replacementOffer      TenantCatalogItem?               @relation("TenantCatalogItemReplacementLineage")

  @@unique([id, tenantId])
  @@unique([currentValueVersionId, tenantId])
  @@unique([supersedesOfferId, tenantId])
  @@unique([tenantId, kind, externalRef])
  @@index([tenantId, kind, canonicalTemplateKey], map: "TenantCatalogItem_tenant_kind_template_idx")
  @@index([tenantId, kind, active])
}

/// Append-only value-bearing configuration for one immutable internal offer.
/// The mutable catalog row is only the current projection; checkout freezes
/// this exact version identity and snapshot before any provider dispatch.
model TenantCatalogItemValueVersion {
  id                String                         @id @default(cuid())
  tenantId          String
  offerId           String
  actionExecutionId String
  previousVersionId String?
  version           Int
  templateKey       String
  offerKind         String
  priceKopecks      Int
  currency          String
  availabilityState String
  valueSnapshotHash String
  createdAt         DateTime                       @default(now())
  tenant            Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  offer             TenantCatalogItem              @relation("TenantCatalogItemValueVersions", fields: [offerId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  actionExecution   ActionExecution                @relation("TenantCatalogItemValueVersionActionExecution", fields: [actionExecutionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  previousVersion   TenantCatalogItemValueVersion? @relation("TenantCatalogItemValueVersionChain", fields: [previousVersionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  nextVersion       TenantCatalogItemValueVersion? @relation("TenantCatalogItemValueVersionChain")
  currentForOffer   TenantCatalogItem?             @relation("TenantCatalogItemCurrentValueVersion")

  @@unique([id, tenantId])
  @@unique([offerId, tenantId, version])
  @@unique([actionExecutionId, tenantId])
  @@unique([previousVersionId, tenantId])
  @@index([tenantId, templateKey, availabilityState], map: "TenantCatalogItemValueVersion_lookup_idx")
}

/// One referral policy per tenant. Referral fulfillment remains a separately
/// entitled add-on; this record is the source of truth for its public rules.
model ReferralProgram {
  id                                 String                        @id @default(cuid())
  tenantId                           String                        @unique
  enabled                            Boolean                       @default(false)
  inviterRewardKopecks               Int?
  inviteeRewardKopecks               Int?
  inviterRewardPercentBasisPoints    Int?
  inviteeRewardPercentBasisPoints    Int?
  inviterRewardLiabilityCapKopecks   Int?
  inviteeRewardLiabilityCapKopecks   Int?
  currency                           String                        @default("RUB")
  terms                              String?
  codePrefix                         String?
  currentValueVersionId              String?
  createdAt                          DateTime                      @default(now())
  updatedAt                          DateTime                      @updatedAt
  tenant                             Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  valueVersions                      ReferralProgramValueVersion[] @relation("ReferralProgramValueVersions")
  currentValueVersion                ReferralProgramValueVersion?  @relation("ReferralProgramCurrentValueVersion", fields: [currentValueVersionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, tenantId])
  @@unique([currentValueVersionId, tenantId])
}

/// Append-only future-issuance value policy for one tenant referral program.
/// Existing referral rewards remain bound to the immutable values copied at
/// issuance and are never recomputed from a later policy version.
model ReferralProgramValueVersion {
  id                               String                       @id @default(cuid())
  tenantId                         String
  programId                        String
  actionExecutionId                String
  previousVersionId                String?
  version                          Int
  enabled                          Boolean
  inviterRewardKopecks             Int?
  inviteeRewardKopecks             Int?
  inviterRewardPercentBasisPoints  Int?
  inviteeRewardPercentBasisPoints  Int?
  inviterRewardLiabilityCapKopecks Int?
  inviteeRewardLiabilityCapKopecks Int?
  currency                         String
  valueSnapshotHash                String
  createdAt                        DateTime                     @default(now())
  tenant                           Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  program                          ReferralProgram              @relation("ReferralProgramValueVersions", fields: [programId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  actionExecution                  ActionExecution              @relation("ReferralProgramValueVersionActionExecution", fields: [actionExecutionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  previousVersion                  ReferralProgramValueVersion? @relation("ReferralProgramValueVersionChain", fields: [previousVersionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  nextVersion                      ReferralProgramValueVersion? @relation("ReferralProgramValueVersionChain")
  currentForProgram                ReferralProgram?             @relation("ReferralProgramCurrentValueVersion")

  @@unique([id, tenantId])
  @@unique([programId, tenantId, version])
  @@unique([actionExecutionId, tenantId])
  @@unique([previousVersionId, tenantId])
  @@index([tenantId, programId, version])
}

/// Tenant-scoped referral fact. Creation and terminal resolution remain
/// separate logical actions; reward issuance is deliberately modeled outside
/// this row so a relationship fact cannot itself grant value.
model CustomerReferral {
  id                    String           @id @default(cuid())
  tenantId              String
  createExecutionId     String?
  resolutionExecutionId String?
  referrerClientId      String
  referredClientId      String?
  identityHash          String
  referredSubjectHash   String
  referralCodeHash      String
  status                String           @default("pending")
  joinedAt              DateTime
  resolvedAt            DateTime?
  legacySourceRef       String?
  createdAt             DateTime         @default(now())
  tenant                Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  referrer              Client           @relation("ReferralReferrer", fields: [referrerClientId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  referredClient        Client?          @relation("ReferralReferredClient", fields: [referredClientId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  createExecution       ActionExecution? @relation("CustomerReferralCreateExecution", fields: [createExecutionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  resolutionExecution   ActionExecution? @relation("CustomerReferralResolutionExecution", fields: [resolutionExecutionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  rewardIssuance        ReferralRewardIssuance?

  @@unique([id, tenantId])
  @@unique([tenantId, identityHash])
  @@unique([createExecutionId, tenantId])
  @@unique([resolutionExecutionId, tenantId])
  @@unique([tenantId, legacySourceRef])
  @@index([tenantId, referredSubjectHash, status])
  @@index([tenantId, referrerClientId, joinedAt])
}

/// One reward-issuance batch for one qualified referral. The action binding is
/// one-to-one; its immutable child rows carry the individual recipient values.
model ReferralRewardIssuance {
  id                 String           @id @default(cuid())
  tenantId           String
  referralId         String
  actionExecutionId  String?
  policySnapshotHash String
  issuedAt           DateTime
  legacySourceRef    String?
  createdAt          DateTime         @default(now())
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  referral           CustomerReferral @relation(fields: [referralId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  actionExecution    ActionExecution? @relation("ReferralRewardIssuanceActionExecution", fields: [actionExecutionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  rewards            ReferralReward[]

  @@unique([id, tenantId])
  @@unique([referralId, tenantId])
  @@unique([actionExecutionId, tenantId])
  @@unique([tenantId, legacySourceRef])
  @@index([tenantId, issuedAt])
}

/// One immutable value slot in a referral issuance batch. Money and percentage
/// rewards keep their native domain facts rather than collapsing into a
/// generic value amount.
model ReferralReward {
  id                 String                     @id @default(cuid())
  tenantId           String
  issuanceId         String
  recipientClientId  String
  rewardSlot         String
  codeHash           String
  amountKopecks      Int?
  currency           String?
  percentBasisPoints Int?
  liabilityCapKopecks Int?
  liabilityCurrency String?
  presentationKeyVersion String?
  issuedAt           DateTime
  expiresAt          DateTime
  createdAt          DateTime                   @default(now())
  tenant             Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  issuance           ReferralRewardIssuance     @relation(fields: [issuanceId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  recipient          Client                     @relation("ReferralRewardRecipient", fields: [recipientClientId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  fulfillment        ReferralRewardFulfillment?

  @@unique([id, tenantId])
  @@unique([tenantId, codeHash])
  @@unique([issuanceId, tenantId, rewardSlot])
  @@index([tenantId, recipientClientId, expiresAt])
}

/// Append-only claim for applying one referral reward. The unique reward
/// identity blocks a second fulfillment through another execution path.
model ReferralRewardFulfillment {
  id                String           @id @default(cuid())
  tenantId          String
  rewardId          String
  actionExecutionId String?
  targetAppointmentId String?
  targetIdentityHash String?
  eligibleAmountKopecks Int?
  appliedAmountKopecks Int?
  currency          String?
  fulfilledAt       DateTime
  legacySourceRef   String?
  createdAt         DateTime         @default(now())
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reward            ReferralReward   @relation(fields: [rewardId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  actionExecution   ActionExecution? @relation("ReferralRewardFulfillmentActionExecution", fields: [actionExecutionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  targetAppointment Appointment?     @relation(fields: [targetAppointmentId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict, map: "ReferralRewardFulfillment_target_appointment_tenant_fkey")

  @@unique([id, tenantId])
  @@unique([rewardId, tenantId])
  @@unique([actionExecutionId, tenantId])
  @@unique([tenantId, legacySourceRef])
  @@unique([tenantId, targetIdentityHash], map: "ReferralRewardFulfillment_tenant_target_hash_key")
  @@index([tenantId, fulfilledAt])
  @@index([tenantId, targetAppointmentId], map: "ReferralRewardFulfillment_tenant_target_appointment_idx")
}

/// One actually activated customer subscription term. A renewal is a new row
/// linked to its predecessor; it never rewrites the predecessor's immutable
/// plan, price, allowance, or term facts.
model CustomerSubscription {
  id                       String                      @id @default(cuid())
  tenantId                 String
  activationExecutionId    String?
  endExecutionId           String?
  clientId                 String
  previousSubscriptionId   String?
  termIdentityHash         String
  planCode                 String
  planSnapshotHash         String
  serviceScopeHash         String
  priceKopecks             Int
  currency                 String
  visitsIncluded           Int
  status                   String                      @default("active")
  provider                 String?
  providerPaymentRefHash   String?
  activatedAt              DateTime
  termStartsAt             DateTime
  termEndsAt               DateTime
  endedAt                  DateTime?
  legacySourceRef          String?
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  tenant                   Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client                   Client                      @relation(fields: [clientId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  activationExecution      ActionExecution?            @relation("CustomerSubscriptionActivationExecution", fields: [activationExecutionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  endExecution             ActionExecution?            @relation("CustomerSubscriptionEndExecution", fields: [endExecutionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  previousSubscription     CustomerSubscription?        @relation("CustomerSubscriptionRenewal", fields: [previousSubscriptionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  renewal                  CustomerSubscription?        @relation("CustomerSubscriptionRenewal")
  usages                   CustomerSubscriptionUsage[]

  @@unique([id, tenantId])
  @@unique([tenantId, termIdentityHash])
  @@unique([activationExecutionId, tenantId])
  @@unique([endExecutionId, tenantId])
  @@unique([previousSubscriptionId, tenantId])
  @@unique([tenantId, provider, providerPaymentRefHash])
  @@unique([tenantId, legacySourceRef])
  @@index([tenantId, clientId, status, termEndsAt])
  @@index([tenantId, status, termEndsAt])
}

/// Append-only evidence that one or more units of a subscription term were
/// consumed. A sync action may own multiple claims, while the subscription-
/// qualified usage identity prevents another execution from claiming the same
/// visit or source event twice.
model CustomerSubscriptionUsage {
  id                       String                @id @default(cuid())
  tenantId                 String
  subscriptionId           String
  actionExecutionId        String?
  usageIdentityHash        String
  targetKind               String
  targetRefHash            String
  units                    Int                   @default(1)
  usedAt                   DateTime
  legacySourceRef          String?
  createdAt                DateTime              @default(now())
  tenant                   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription             CustomerSubscription  @relation(fields: [subscriptionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  actionExecution          ActionExecution?      @relation("CustomerSubscriptionUsageActionExecution", fields: [actionExecutionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, tenantId])
  @@unique([subscriptionId, tenantId, usageIdentityHash])
  @@unique([tenantId, legacySourceRef])
  @@index([actionExecutionId, tenantId])
  @@index([subscriptionId, tenantId, usedAt])
}

/// One tenant-owned certificate issuance and its provider payment lifecycle.
/// The bearer secret is represented only by a server-derived hash; the
/// non-secret presentation key version makes re-presentation restart-safe.
/// Recipient and offer facts are immutable snapshots, not mutable catalog data.
model GiftCertificate {
  id                       String                     @id @default(cuid())
  tenantId                 String
  issueExecutionId         String?
  issuanceIdentityHash     String
  codeHash                 String
  presentationKeyVersion   String?
  recipientSubjectHash     String
  offerSnapshotHash        String
  nominalAmountKopecks     Int
  currency                 String
  paymentStatus            String                     @default("pending_payment")
  provider                 String?
  providerPaymentRefHash   String?
  issuedAt                 DateTime
  expiresAt                DateTime
  paidAt                   DateTime?
  canceledAt               DateTime?
  legacySourceRef          String?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  tenant                   Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  issueExecution           ActionExecution?           @relation("GiftCertificateIssueExecution", fields: [issueExecutionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  redemption               GiftCertificateRedemption?

  @@unique([id, tenantId])
  @@unique([tenantId, issuanceIdentityHash])
  @@unique([tenantId, codeHash])
  @@unique([issueExecutionId, tenantId])
  @@unique([tenantId, provider, providerPaymentRefHash])
  @@unique([tenantId, legacySourceRef])
  @@index([tenantId, paymentStatus, expiresAt])
  @@index([tenantId, recipientSubjectHash, expiresAt])
}

/// Append-only claim that consumes one paid certificate in full. Partial
/// balance semantics are intentionally absent because the approved and legacy
/// contract is one certificate -> at most one full redemption.
model GiftCertificateRedemption {
  id                       String           @id @default(cuid())
  tenantId                 String
  certificateId            String
  actionExecutionId        String?
  targetKind               String
  targetRefHash            String
  redeemedAt               DateTime
  legacySourceRef          String?
  createdAt                DateTime         @default(now())
  tenant                   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  certificate              GiftCertificate  @relation(fields: [certificateId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  actionExecution          ActionExecution? @relation("GiftCertificateRedemptionActionExecution", fields: [actionExecutionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, tenantId])
  @@unique([certificateId, tenantId])
  @@unique([actionExecutionId, tenantId])
  @@unique([tenantId, legacySourceRef])
  @@index([tenantId, redeemedAt])
}

/// Review text can contain names and other personal data, so it is encrypted
/// at rest. AI tools receive only rating, source, date and deterministic topic
/// tags, never the original text.
model BusinessReview {
  id              String   @id @default(cuid())
  tenantId        String
  externalRef     String?
  source          String
  rating          Int
  occurredAt      DateTime
  encryptedText   String?
  topicTagsJson   Json?
  branchId        String?
  staffExternalId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, source, externalRef])
  @@index([tenantId, occurredAt])
  @@index([tenantId, rating, occurredAt])
}

model InternalService {
  id                  String                    @id @default(cuid())
  tenantId            String
  name                String
  description         String?
  price               Int
  currency            String                    @default("RUB")
  durationMinutes     Int
  bufferBeforeMinutes Int                       @default(0)
  bufferAfterMinutes  Int                       @default(0)
  active              Boolean                   @default(true)
  sortOrder           Int                       @default(0)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  tenant              Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  providers           InternalProviderService[]

  @@unique([id, tenantId])
  @@index([tenantId, active, sortOrder])
}

model InternalProvider {
  id                  String                          @id @default(cuid())
  tenantId            String
  userId              String?
  branchId            String?
  displayName         String
  title               String?
  specialization      String?
  avatarUrl           String?
  active              Boolean                         @default(true)
  slotIntervalMinutes Int                             @default(30)
  createdAt           DateTime                        @default(now())
  updatedAt           DateTime                        @updatedAt
  tenant              Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                User?                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership          Membership?                     @relation("InternalProviderMembership", fields: [userId, tenantId], references: [userId, tenantId], onDelete: Cascade)
  branch              Branch?                         @relation(fields: [branchId, tenantId], references: [id, tenantId], onDelete: Restrict)
  services            InternalProviderService[]
  availabilityRules   InternalAvailabilityRule[]
  exceptions          InternalAvailabilityException[]

  @@unique([id, tenantId])
  @@unique([tenantId, userId])
  @@index([tenantId, active])
  @@index([branchId])
}

model AiOnboardingDraft {
  id                   String           @id @default(cuid())
  draftTokenHash       String           @unique
  status               String           @default("draft")
  templateId           String
  blueprintJson        Json
  missingFieldsJson    Json
  inputDigest          String?
  lastAssistantMessage String?
  quickRepliesJson     Json             @default("[]")
  lastConfidence       Float?
  needsClarification   Boolean          @default(false)
  interpreterSource    String           @default("safe_fallback")
  turnCount            Int              @default(1)
  expiresAt            DateTime
  confirmedTenantId    String?
  trialActivationId    String?          @unique
  /// Approved Package 5 confirmation receipt V1; no historical approval backfill.
  revision             Int              @default(0)
  confirmationReceiptJson Json?
  confirmationMaterialEncrypted String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  confirmedTenant      Tenant?          @relation("AiOnboardingConfirmedTenant", fields: [confirmedTenantId], references: [id], onDelete: SetNull)
  trialActivation      TrialActivation? @relation(fields: [trialActivationId], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@index([confirmedTenantId])
}

model TrialActivation {
  id                  String             @id @default(cuid())
  activationTokenHash String             @unique
  status              String             @default("pending")
  source              String             @default("maya_os")
  expiresAt           DateTime
  completedAt         DateTime?
  tenantId            String?            @unique
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  tenant              Tenant?            @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  draft               AiOnboardingDraft?

  @@index([status, expiresAt])
  @@index([completedAt])
}

model CustomerProfile {
  id                 String     @id @default(cuid())
  tenantId           String
  clientId           String?
  userId             String?
  preferredLocale    String?
  /// Explicit Client choices only; NULL inherits policy and is not consent.
  defaultVisitMood   String?
  notificationPreferencesJson Json?
  privacyConsentAt   DateTime?
  marketingConsentAt DateTime?
  encryptedNotes     String?
  /// B7 Client-stated habits, encrypted under canonical limits V1; no backfill.
  encryptedClientPreferences String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  tenant             Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client             Client?    @relation(fields: [clientId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  user               User?      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  membership         Membership? @relation("CustomerProfileMembership", fields: [userId, tenantId], references: [userId, tenantId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([userId, tenantId])
  @@unique([tenantId, clientId])
  @@index([tenantId, updatedAt])
}

/// Append-only proof of a canonical Client's consent decision. Current
/// CustomerProfile timestamps remain compatibility projections and are not
/// accepted as historical evidence by themselves.
model ClientConsentFact {
  id                   String   @id @default(uuid())
  tenantId             String
  clientId             String
  kind                 String
  decision             String
  occurredAt           DateTime
  effectiveAt          DateTime
  sourceType           String
  sourceIdentityHash   String
  actorUserId          String?
  actionExecutionId    String?
  createdAt            DateTime @default(now())

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client      Client           @relation(fields: [clientId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  actor       Membership?      @relation("ClientConsentActor", fields: [actorUserId, tenantId], references: [userId, tenantId], onDelete: Restrict, onUpdate: Restrict)
  execution   ActionExecution? @relation(fields: [actionExecutionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  invalidation ClientConsentInvalidation?

  @@unique([id, tenantId, clientId], map: "ConsentFact_client_reference_key")
  @@unique([id, tenantId])
  @@unique([tenantId, sourceType, sourceIdentityHash])
  @@index([tenantId, clientId, kind, effectiveAt])
  @@index([tenantId, actionExecutionId])
}

model LoyaltyAccount {
  id                String               @id @default(cuid())
  tenantId          String
  clientId          String?
  userId            String?
  source            String               @default("internal")
  balance           Int                  @default(0)
  externalReference String?
  syncedAt          DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client            Client?              @relation(fields: [clientId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  user              User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  membership        Membership?          @relation("LoyaltyAccountMembership", fields: [userId, tenantId], references: [userId, tenantId], onDelete: Restrict, onUpdate: Restrict)
  transactions      LoyaltyTransaction[]

  @@unique([id, tenantId])
  @@unique([userId, tenantId])
  @@unique([tenantId, clientId])
  @@index([tenantId, source, updatedAt])
}

model LoyaltyTransaction {
  id                String           @id @default(cuid())
  tenantId          String
  actionExecutionId String?
  accountId         String
  actorUserId       String?
  actorTenantId     String?
  kind              String
  delta             Int
  balanceAfter      Int
  encryptedReason   String
  idempotencyKey    String
  externalRef       String?
  createdAt         DateTime         @default(now())
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account           LoyaltyAccount   @relation(fields: [accountId, tenantId], references: [id, tenantId], onDelete: Cascade)
  actor             User?            @relation("LoyaltyTransactionActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actionExecution   ActionExecution? @relation("LoyaltyTransactionActionExecution", fields: [actionExecutionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, actionExecutionId])
  @@index([tenantId, accountId, createdAt])
  @@index([tenantId, actorUserId, createdAt])
}

/// One tenant-scoped, one-time loyalty right. The bearer code is stored only
/// as a server-derived hash; the immutable target and point value remain
/// domain facts rather than a generic value-ledger payload.
model LoyaltyRedemptionGrant {
  id               String           @id @default(cuid())
  tenantId         String
  issueExecutionId String?
  clientId         String
  codeHash         String
  serviceRef       String
  points           Int
  issuedAt         DateTime
  expiresAt        DateTime
  legacySourceRef  String?
  createdAt        DateTime         @default(now())
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client           Client           @relation(fields: [clientId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  issueExecution   ActionExecution? @relation("LoyaltyRedemptionGrantIssueExecution", fields: [issueExecutionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  redemption       LoyaltyRedemption?
  revocation       LoyaltyRedemptionGrantRevocation?

  @@unique([id, tenantId])
  @@unique([tenantId, codeHash])
  @@unique([issueExecutionId, tenantId])
  @@unique([tenantId, legacySourceRef])
  @@index([tenantId, clientId, expiresAt])
}

/// Append-only one-time claim for a loyalty grant. A separate row makes issue
/// and consume distinct logical actions and lets the database reject a second
/// redemption even when it arrives through another execution path.
model LoyaltyRedemption {
  id                String           @id @default(cuid())
  tenantId          String
  grantId           String
  actionExecutionId String?
  redeemedAt        DateTime
  legacySourceRef   String?
  createdAt         DateTime         @default(now())
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  grant             LoyaltyRedemptionGrant @relation(fields: [grantId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  actionExecution   ActionExecution? @relation("LoyaltyRedemptionActionExecution", fields: [actionExecutionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, tenantId])
  @@unique([grantId, tenantId])
  @@unique([actionExecutionId, tenantId])
  @@unique([tenantId, legacySourceRef])
  @@index([tenantId, redeemedAt])
}

/// Append-only revocation of one still-active loyalty grant. Revocation is a
/// distinct terminal fact from expiry or redemption and always belongs to one
/// canonical ActionExecution; no nullable legacy escape hatch exists.
model LoyaltyRedemptionGrantRevocation {
  id                String                 @id @default(cuid())
  tenantId          String
  grantId           String
  actionExecutionId String
  reasonCode        String
  revokedAt         DateTime
  createdAt         DateTime               @default(now())
  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  grant             LoyaltyRedemptionGrant @relation(fields: [grantId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  actionExecution   ActionExecution        @relation("LoyaltyRedemptionGrantRevocationActionExecution", fields: [actionExecutionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict, map: "LoyaltyGrantRevocation_execution_tenant_fkey")

  @@unique([id, tenantId])
  @@unique([grantId, tenantId])
  @@unique([actionExecutionId, tenantId])
  @@index([tenantId, revokedAt])
}

/// Tenant-qualified, fail-closed record of one known provider-identity
/// collision. The legacy principal manifest stays outside this table; only its
/// immutable evidence digest and cardinality are persisted, never raw PII.
model UnresolvedClientIdentityHold {
  id                          String           @id @default(cuid())
  tenantId                    String
  provider                    String
  externalId                  String
  reasonCode                  String
  sourceNamespace             String
  sourceEvidenceHash          String
  unresolvedPrincipalCount    Int
  createdAt                   DateTime         @default(now())
  resolvedAt                  DateTime?
  resolutionActionExecutionId String?
  tenant                      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resolutionActionExecution   ActionExecution? @relation("UnresolvedClientIdentityHoldResolutionExecution", fields: [resolutionActionExecutionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict, map: "UnresolvedIdentityHold_resolution_execution_tenant_fkey")

  @@unique([tenantId, provider, externalId], map: "UnresolvedClientIdentityHold_tenant_provider_external_key")
  @@index([tenantId, reasonCode, resolvedAt], map: "UnresolvedClientIdentityHold_tenant_reason_resolved_idx")
}

model Expense {
  id                String           @id @default(cuid())
  tenantId          String
  actionExecutionId String?
  branchId          String?
  branchTenantId    String?
  createdById       String?
  createdByTenantId String?
  category          String
  amountKopecks     Int
  currency          String           @default("RUB")
  occurredAt        DateTime
  encryptedNote     String?
  source            String           @default("manual")
  externalId        String?
  idempotencyKey    String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch            Branch?          @relation(fields: [branchId, branchTenantId], references: [id, tenantId], onDelete: SetNull)
  createdBy         User?            @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  actionExecution   ActionExecution? @relation("ExpenseActionExecution", fields: [actionExecutionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, tenantId])
  @@unique([actionExecutionId, tenantId])
  @@unique([tenantId, externalId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, occurredAt])
  @@index([tenantId, branchId, occurredAt])
  @@index([tenantId, source, occurredAt])
}

/// Явное подтверждение владельца, что за конкретный период все расходы,
/// кроме системной зарплаты из CRM, уже внесены. Нулевая аренда не создаётся:
/// собственное помещение — нормальный сценарий, а не фиктивный расход.
model ExpensePeriodDeclaration {
  id                String           @id @default(cuid())
  tenantId          String
  actionExecutionId String?
  declaredById      String?
  periodFromDay     String
  periodToDay       String
  declarationEpoch  Int?
  idempotencyKey    String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  declaredBy        User?            @relation("ExpensePeriodDeclarer", fields: [declaredById], references: [id], onDelete: SetNull)
  actionExecution   ActionExecution? @relation("ExpensePeriodDeclarationActionExecution", fields: [actionExecutionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([actionExecutionId, tenantId])
  @@unique([tenantId, periodFromDay, periodToDay])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, periodFromDay, periodToDay])
}

/// Append-only boundary between two current expense-period declaration
/// generations. The invalidated declaration row may be physically deleted,
/// so its id and canonical ActionExecution remain as immutable evidence here.
model ExpensePeriodDeclarationInvalidation {
  id                                      String   @id @default(uuid())
  tenantId                                String
  periodFromDay                           String
  periodToDay                             String
  invalidatedDeclarationId                String
  invalidatedDeclarationActionExecutionId String
  invalidationActionExecutionId           String
  previousDeclarationEpoch                Int
  nextDeclarationEpoch                    Int
  reasonCode                              String
  createdAt                               DateTime @default(now())

  tenant                                Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "ExpensePeriodInvalidation_tenant_fkey")
  invalidatedDeclarationActionExecution ActionExecution @relation("ExpensePeriodInvalidatedDeclarationExecution", fields: [invalidatedDeclarationActionExecutionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict, map: "ExpensePeriodInvalidation_decl_exec_fkey")
  invalidationActionExecution           ActionExecution @relation("ExpensePeriodInvalidationExecution", fields: [invalidationActionExecutionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict, map: "ExpensePeriodInvalidation_action_exec_fkey")

  @@unique([id, tenantId], map: "ExpensePeriodInvalidation_id_tenant_key")
  @@unique([tenantId, invalidatedDeclarationActionExecutionId], map: "ExpensePeriodInvalidation_decl_exec_key")
  @@unique([tenantId, periodFromDay, periodToDay, nextDeclarationEpoch], map: "ExpensePeriodInvalidation_period_epoch_key")
  @@unique([tenantId, invalidationActionExecutionId, invalidatedDeclarationId], map: "ExpensePeriodInvalidation_action_decl_key")
  @@index([tenantId, periodFromDay, periodToDay, nextDeclarationEpoch], map: "ExpensePeriodInvalidation_period_epoch_idx")
}

model AiApprovalRequest {
  id                  String           @id @default(cuid())
  tenantId            String
  requestedByUserId   String?
  requestedByTenantId String?
  decidedByUserId     String?
  decidedByTenantId   String?
  toolName            String
  surface             String
  riskTier            String
  approvalPolicy      String
  status              String           @default("pending")
  summary             String
  payloadHash         String
  payloadPreviewJson  Json
  encryptedArguments  String
  idempotencyKey      String
  expiresAt           DateTime
  decidedAt           DateTime?
  executedAt          DateTime?
  errorCode           String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  tenant              Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestedBy         User?            @relation("AiApprovalRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  decidedBy           User?            @relation("AiApprovalDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  execution           AiToolExecution?

  @@unique([id, tenantId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, expiresAt])
  @@index([tenantId, requestedByUserId, createdAt])

  // Wave R-C Option A: approved owner bindings and relations.
  expenseIntakeBinding ExpenseIntakeBinding[] @relation("R13_intake_approval")
}

