model User {
  authorizedConsentInvalidations ClientConsentInvalidation[]
  id                        String                     @id @default(cuid())
  tenantId                  String?
  branchId                  String?
  email                     String
  phone                     String?
  encryptedName             String?
  passwordHash              String
  role                      UserRole
  status                    UserStatus                 @default(active)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  tenant                    Tenant?                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch                    Branch?                    @relation(fields: [branchId, tenantId], references: [id, tenantId], onDelete: Restrict)
  auditLogs                 AuditLog[]
  clients                   Client[]
  appointments              Appointment[]              @relation("ClientAppointments")
  authIdentities            AuthIdentity[]
  authSessions              AuthSession[]
  memberships               Membership[]
  internalProviders         InternalProvider[]
  customerProfiles          CustomerProfile[]
  loyaltyAccounts           LoyaltyAccount[]
  loyaltyTransactions       LoyaltyTransaction[]       @relation("LoyaltyTransactionActor")
  createdExpenses           Expense[]                  @relation("ExpenseCreator")
