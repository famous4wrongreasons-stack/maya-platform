// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  trial
  active
  past_due
  suspended
  cancelled
}

enum UserRole {
  platform_owner
  platform_admin
  tenant_owner
  business_owner
  administrator
  manager
  provider
  employee
  accountant
  customer
  integration_service
  tenant_admin
  branch_manager
  staff
  client
}

enum UserStatus {
  active
  suspended
  invited
  // Терминальный статус погашенного дубля. Обратно в active не переводится:
  // suspended для этой роли не подходит — его воскрешает сверка с CRM.
  merged
}

enum MembershipStatus {
  active
  suspended
  invited
}

enum CrmStaffAccessStatus {
  pending_contact
  active
  disabled
}

enum CalendarSource {
  internal
  external
}

enum OpportunityLifecycleStatus {
  active
  resolved
  expired
  superseded
}

enum OpportunityOutcome {
  inform_only
  investigation_required
  action_candidate
}

enum OpportunityAgentDomain {
  admin
  client_lifecycle
  occupancy
  business_intelligence
}

enum AgentTaskLifecycleStatus {
  current
  invalidated
}

enum ActionExecutionState {
  PENDING_APPROVAL
  READY
  EXECUTING
  UNKNOWN
  SUCCEEDED
  FAILED
  NOT_EXECUTED
}

enum ActionPolicyDecision {
  ALLOW
  DENY
  SHADOW_ONLY
}

enum ActionApprovalDecision {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum ActionReconciliationState {
  NOT_REQUIRED
  REQUIRED
  IN_PROGRESS
  RESOLVED
  MANUAL_REQUIRED
}

enum ActionAttemptKind {
  EXECUTION
  RECONCILIATION
}

enum ActionAttemptState {
  STARTED
  SUCCEEDED
  FAILED
  UNKNOWN
}

enum ExternalDispatchState {
  NOT_APPLICABLE
  NOT_CROSSED
  MAY_HAVE_CROSSED
  ACKNOWLEDGED
}

enum CommunicationScope {
  SINGLE
  BULK
}

enum CommunicationDeliveryState {
  NOT_SENT
  ACCEPTED
  DELIVERED
  FAILED
  UNKNOWN
  SKIPPED
}

enum CommunicationCampaignState {
  DRAFT
  READY
  RUNNING
  UNRESOLVED
  COMPLETED
  PARTIAL
  FAILED
  SKIPPED
  CANCELLED
  EXPIRED
  LEGACY_UNRESOLVED
}

model Tenant {
  id                             String                          @id @default(cuid())
  name                           String
  slug                           String                          @unique
  status                         TenantStatus                    @default(trial)
  planId                         String?
  industryPresetId               String?
  calendarSource                 CalendarSource                  @default(external)
  defaultCurrency                String                          @default("RUB")
  defaultTimezone                String                          @default("Europe/Moscow")
  defaultLocale                  String                          @default("ru-RU")
  customDomain                   String?                         @unique
  subdomain                      String?                         @unique
  trialEndsAt                    DateTime?
  currentPeriodStart             DateTime?
  currentPeriodEnd               DateTime?
  pastDueAt                      DateTime?
  graceEndsAt                    DateTime?
  billingMethodId                String?
  trialFullAccess                Boolean                         @default(false)
  allowSelfRegistration          Boolean                         @default(true)
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
  plan                           SubscriptionPlan?               @relation(fields: [planId], references: [id])
  brandingSettings               BrandingSettings?
  branches                       Branch[]
  users                          User[]
  crmIntegration                 CrmIntegration?
  commerceIntegration            CommerceIntegration?
  auditLogs                      AuditLog[]
  appointments                   Appointment[]
  phoneAuthCodes                 PhoneAuthCode[]
  emailAuthCodes                 EmailAuthCode[]
  authIdentities                 AuthIdentity[]
  authFlowStates                 AuthFlowState[]
  authSessions                   AuthSession[]
  authRateLimitBuckets           AuthRateLimitBucket[]
  billingPayments                BillingPayment[]
  memberships                    Membership[]
  entitlements                   TenantEntitlement[]
  internalServices               InternalService[]
  internalProviders              InternalProvider[]
  availabilityRules              InternalAvailabilityRule[]
  availabilityExceptions         InternalAvailabilityException[]
  aiOnboardingDrafts             AiOnboardingDraft[]             @relation("AiOnboardingConfirmedTenant")
  trialActivation                TrialActivation?
  customerProfiles               CustomerProfile[]
  loyaltyAccounts                LoyaltyAccount[]
  loyaltyTransactions            LoyaltyTransaction[]
  loyaltyRedemptionGrants        LoyaltyRedemptionGrant[]
  loyaltyRedemptions             LoyaltyRedemption[]
  expenses                       Expense[]
  expensePeriodDeclarations      ExpensePeriodDeclaration[]
  aiApprovalRequests             AiApprovalRequest[]
  aiToolExecutions               AiToolExecution[]
  aiBrainSessions                AiBrainSession[]
  aiMemoryFacts                  AiMemoryFact[]
  aiKnowledgeSources             AiKnowledgeSource[]
  aiKnowledgeChunks              AiKnowledgeChunk[]
  crmStaffAccesses               CrmStaffAccess[]
  dashboardPreferences           DashboardPreference[]
  userMerges                     UserMerge[]
  inboxItems                     InboxItem[]
  domainEvents                   DomainEvent[]
  ingestionQuarantine            IngestionQuarantine[]
  reconciliationRuns             ReconciliationRun[]
  devicePushTokens               DevicePushToken[]
  recoveryTouchpoints            RecoveryTouchpoint[]
  recoveryConversions            RecoveryConversion[]
  marketingAudiences             MarketingAudience[]
  marketingCampaigns             MarketingCampaign[]
  appointmentNotificationSetting AppointmentNotificationSetting?
  catalogItems                   TenantCatalogItem[]
  referralProgram                ReferralProgram?
  customerReferrals              CustomerReferral[]
  referralRewardIssuances        ReferralRewardIssuance[]
  referralRewards                ReferralReward[]
  referralRewardFulfillments     ReferralRewardFulfillment[]
  customerSubscriptions          CustomerSubscription[]
  customerSubscriptionUsages     CustomerSubscriptionUsage[]
  businessReviews                BusinessReview[]
  clients                        Client[]
  crmClientLinks                 CrmClientLink[]
  staff                          Staff[]
  staffProviderLinks             StaffProviderLink[]
  marketingPolicy                MarketingPolicy?
  marketingAudienceRecipients    MarketingAudienceRecipient[]
  marketingCampaignRecipients    MarketingCampaignRecipient[]
  marketingConsentEvidence       MarketingConsentEvidence[]
  marketingDeliveryAttempts      MarketingDeliveryAttempt[]
  opportunities                  Opportunity[]
  agentTasks                     AgentTask[]
  actionExecutions               ActionExecution[]
  actionAttempts                 ActionAttempt[]

  @@index([status, graceEndsAt])
}

/// Durable Chapter 5 interpretation of current canonical evidence. This row
/// stores only opaque evidence references and deterministic policy metadata;
/// it does not own business truth or execution state.
model Opportunity {
  id                          String                     @id @default(cuid())
  tenantId                    String
  type                        String
  identityVersion             Int                        @default(1)
  semanticKey                 String
  identityFingerprint         String
  revision                    Int
  affectedEntityKind          String?
  affectedEntityRef           String?
  evidenceFingerprint         String
  evidenceRefsJson            Json
  evidenceObservedAt          DateTime
  limitationsJson             Json
  policyKey                   String
  policyVersion               Int
  recommendedAgentDomain      OpportunityAgentDomain
  outcome                     OpportunityOutcome
  status                      OpportunityLifecycleStatus @default(active)
  firstDetectedAt             DateTime
  lastValidatedAt             DateTime
  expiresAt                   DateTime
  terminalAt                  DateTime?
  terminalReasonCode          String?
  terminalEvidenceFingerprint String?
  terminalEvidenceRefsJson    Json?
  supersedesOpportunityId     String?
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt
  tenant                      Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supersedes                  Opportunity?               @relation("OpportunitySupersession", fields: [supersedesOpportunityId, tenantId, semanticKey], references: [id, tenantId, semanticKey], onDelete: Restrict)
  supersededBy                Opportunity[]              @relation("OpportunitySupersession")
  agentTasks                  AgentTask[]

  @@unique([id, tenantId])
  @@unique([id, tenantId, semanticKey])
  @@unique([tenantId, identityFingerprint])
  @@unique([tenantId, semanticKey, revision])
  @@unique([tenantId, supersedesOpportunityId])
  @@index([tenantId, status, expiresAt])
  @@index([tenantId, type, status])
  @@index([tenantId, semanticKey, revision])
}

/// Durable Chapter 5 assignment record. It is deliberately not an execution
/// job: retries, approvals, delivery and provider outcomes belong to Chapter 6.
model AgentTask {
  id                      String                   @id @default(cuid())
  tenantId                String
  opportunityId           String
  semanticKey             String
  taskFingerprint         String
  agentDomain             OpportunityAgentDomain
  objectiveKey            String
  allowedReadCapabilities Json
  allowedActionClasses    Json
  autonomyLevel           String                   @default("L2_5_SHADOW")
  status                  AgentTaskLifecycleStatus @default(current)
  requestedAt             DateTime
  expiresAt               DateTime
  invalidatedAt           DateTime?
  invalidationReasonCode  String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  tenant                  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  opportunity             Opportunity              @relation(fields: [opportunityId, tenantId, semanticKey], references: [id, tenantId, semanticKey], onDelete: Restrict)
  actionExecutions        ActionExecution[]

  @@unique([id, tenantId])
  @@unique([tenantId, taskFingerprint])
  @@unique([tenantId, opportunityId, agentDomain])
  @@index([tenantId, status, expiresAt])
  @@index([tenantId, semanticKey, agentDomain, status])
}

/// Canonical Chapter 6 lifecycle for one logical action. It stores a trusted,
/// normalized contract and durable outcome state, never raw model output or
/// unrestricted provider payloads.
model ActionExecution {
  id                        String  @id @default(uuid())
  tenantId                  String
  identityVersion           Int
  identityFingerprint       String
  idempotencyScope          String?
  requestIdempotencyKeyHash String?

  sourceType  String
  sourceRef   String?
  agentTaskId String?
  actorUserId String?

  actionClass              String
  capability               String
  capabilityVersion        Int
  targetKind               String
  targetRef                String
  normalizedInputContract  String
  normalizedInputHash      String
  normalizedInputEncrypted String?
  evidenceRefsJson         Json
  intentExpiresAt          DateTime?
  dryRun                   Boolean   @default(false)

  riskProfileVersion    Int
  riskFacetsJson        Json
  policyKey             String
  policyVersion         Int
  policyDecision        ActionPolicyDecision
  autonomyLevel         String
  policyDecidedBy       String
  policyContextContract String?
  policyContextHash     String?
  policyEvidenceJson    Json?
  policyEvaluatedAt     DateTime?
  policyValidUntil      DateTime?

  approvalRequirement     String
  approvalDecision        ActionApprovalDecision
  approvalInputHash       String?
  approvalBindingHash     String?
  approvalRequestedAt     DateTime?
  approvalExpiresAt       DateTime?
  approvalDecidedAt       DateTime?
  approvalDecidedByUserId String?

  state                       ActionExecutionState
  notExecutedReasonCode       String?
  retryPolicyKey              String
  retryPolicyVersion          Int
  maxExecutionAttempts        Int
  executionAttemptCount       Int                       @default(0)
  nextExecutionAttemptAt      DateTime?
  reconciliationPolicyKey     String
  reconciliationPolicyVersion Int
  reconciliationState         ActionReconciliationState

  leaseOwner     String?
  leaseTokenHash String?
  leaseExpiresAt DateTime?
  revision       Int       @default(0)

  transportIdentityVersion  Int
  transportIdempotencyKey   String
  finalOutcomeCode          String?
  safeResultSummaryJson     Json?
  userExplanationCode       String?
  userExplanationParamsJson Json?
  firstAttemptedAt          DateTime?
  finalizedAt               DateTime?
  payloadRetentionUntil     DateTime?
  auditRetentionUntil       DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  tenant                Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentTask             AgentTask?         @relation(fields: [agentTaskId, tenantId], references: [id, tenantId], onDelete: Restrict)
  actorMembership       Membership?        @relation("ActionActor", fields: [actorUserId, tenantId], references: [userId, tenantId], onDelete: Restrict)
  approverMembership    Membership?        @relation("ActionApprover", fields: [approvalDecidedByUserId, tenantId], references: [userId, tenantId], onDelete: Restrict)
  attempts              ActionAttempt[]
  communicationCampaign MarketingCampaign?
  billingPayment        BillingPayment?    @relation("BillingPaymentActionExecution")
  loyaltyTransactions   LoyaltyTransaction[] @relation("LoyaltyTransactionActionExecution")
  issuedLoyaltyRedemptionGrant LoyaltyRedemptionGrant? @relation("LoyaltyRedemptionGrantIssueExecution")
  loyaltyRedemption     LoyaltyRedemption? @relation("LoyaltyRedemptionActionExecution")
  createdCustomerReferral CustomerReferral? @relation("CustomerReferralCreateExecution")
  resolvedCustomerReferral CustomerReferral? @relation("CustomerReferralResolutionExecution")
  referralRewardIssuance ReferralRewardIssuance? @relation("ReferralRewardIssuanceActionExecution")
  referralRewardFulfillment ReferralRewardFulfillment? @relation("ReferralRewardFulfillmentActionExecution")
  activatedCustomerSubscription CustomerSubscription? @relation("CustomerSubscriptionActivationExecution")
  endedCustomerSubscription CustomerSubscription? @relation("CustomerSubscriptionEndExecution")
  customerSubscriptionUsages CustomerSubscriptionUsage[] @relation("CustomerSubscriptionUsageActionExecution")
  expense               Expense?           @relation("ExpenseActionExecution")
  expensePeriodDeclaration ExpensePeriodDeclaration? @relation("ExpensePeriodDeclarationActionExecution")

  @@unique([id, tenantId])
  @@unique([tenantId, identityFingerprint])
  @@unique([tenantId, idempotencyScope, requestIdempotencyKeyHash], map: "ActionExecution_tenant_idempotency_key")
  @@index([tenantId, state, nextExecutionAttemptAt])
  @@index([tenantId, reconciliationState, leaseExpiresAt])
  @@index([tenantId, agentTaskId])
  @@index([tenantId, createdAt])
}

/// Immutable-after-finish ledger entry for execution and reconciliation work.
/// A retry remains an attempt under the same logical ActionExecution.
model ActionAttempt {
  id                          String                @id @default(uuid())
  tenantId                    String
  actionExecutionId           String
  attemptNumber               Int
  kind                        ActionAttemptKind
  state                       ActionAttemptState
  executorKey                 String
  executorVersion             Int
  externalDispatchState       ExternalDispatchState
  providerRequestIdentityHash String?
  providerReferenceEncrypted  String?
  providerReferenceHash       String?
  transportCode               String?
  httpStatus                  Int?
  errorClass                  String?
  outcomeCode                 String?
  safeResultJson              Json?
  retryDecisionCode           String?
  reconciliationRequired      Boolean               @default(false)
  startedAt                   DateTime              @default(now())
  finishedAt                  DateTime?
  createdAt                   DateTime              @default(now())

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  execution ActionExecution @relation(fields: [actionExecutionId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([tenantId, actionExecutionId, attemptNumber])
  @@index([tenantId, state, startedAt])
  @@index([tenantId, providerReferenceHash])
}

/// Tenant-wide transactional appointment reminder policy. These notices are
/// operational, not marketing: delivery is limited to the authenticated MAYA
/// account whose phone exactly matches the CRM appointment.
model AppointmentNotificationSetting {
  id               String   @id @default(cuid())
  tenantId         String   @unique
  enabled          Boolean  @default(true)
  leadTimesMinutes Json     @default("[1440,120]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([enabled])
}

/// Persisted white-label BrandingConfig. The database model name is retained
/// during the compatibility phase so existing Prisma calls keep working.
model BrandingSettings {
  id                   String   @id @default(cuid())
  tenantId             String   @unique
  logoUrl              String?
  iconUrl              String?
  faviconUrl           String?
  appName              String?
  primaryColor         String?
  secondaryColor       String?
  accentColor          String?
  backgroundColor      String?
  surfaceColor         String?
  textPrimaryColor     String?
  textSecondaryColor   String?
  backgroundImageUrl   String?
  fontFamily           String?
  headingFontFamily    String?
  buttonRadius         Int?
  buttonStyle          String?
  themeMode            String   @default("system")
  borderRadiusJson     Json?
  contactDetailsJson   Json?
  socialLinksJson      Json?
  mapLinksJson         Json?
  legalLinksJson       Json?
  splashScreenJson     Json?
  onboardingJson       Json?
  storeListingJson     Json?
  emailBrandingJson    Json?
  telegramBrandingJson Json?
  themeJson            Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Branch {
  id                String             @id @default(cuid())
  tenantId          String
  name              String
  address           String?
  phone             String?
  timezone          String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users             User[]
  appointments      Appointment[]
  internalProviders InternalProvider[]
  staff             Staff[]
  expenses          Expense[]
  memberships       Membership[]

  @@unique([id, tenantId])
  @@index([tenantId])
}

model User {
  id                        String                     @id @default(cuid())
  tenantId                  String?
  branchId                  String?
  email                     String
  phone                     String?
  encryptedName             String?
  passwordHash              String
  role                      UserRole
  status                    UserStatus                 @default(active)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  tenant                    Tenant?                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch                    Branch?                    @relation(fields: [branchId, tenantId], references: [id, tenantId], onDelete: Restrict)
  auditLogs                 AuditLog[]
  clients                   Client[]
  appointments              Appointment[]              @relation("ClientAppointments")
  authIdentities            AuthIdentity[]
  authSessions              AuthSession[]
  memberships               Membership[]
  internalProviders         InternalProvider[]
  customerProfiles          CustomerProfile[]
  loyaltyAccounts           LoyaltyAccount[]
  loyaltyTransactions       LoyaltyTransaction[]       @relation("LoyaltyTransactionActor")
  createdExpenses           Expense[]                  @relation("ExpenseCreator")
  expensePeriodDeclarations ExpensePeriodDeclaration[] @relation("ExpensePeriodDeclarer")
  requestedAiApprovals      AiApprovalRequest[]        @relation("AiApprovalRequester")
  decidedAiApprovals        AiApprovalRequest[]        @relation("AiApprovalDecider")
  aiToolExecutions          AiToolExecution[]          @relation("AiToolExecutionActor")
  createdAiKnowledgeSources AiKnowledgeSource[]        @relation("AiKnowledgeSourceCreator")
  crmStaffAccesses          CrmStaffAccess[]
  staff                     Staff[]
  inboxItems                InboxItem[]
  devicePushTokens          DevicePushToken[]

  @@unique([id, tenantId])
  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([branchId])
  /// Вход по почте ищет пользователя ПО ВСЕМ арендаторам, поэтому составные
  /// ключи с ведущим tenantId для него непригодны — без этих двух индексов
  /// каждая попытка входа сканирует таблицу целиком.
  @@index([email])
  @@index([phone])
}

/// Карта слияния дублей аккаунта.
///
/// Дубли появлялись, когда соц-вход не находил рабочий аккаунт и заводил
/// человеку второй, клиентский. Слияние переносит владение на рабочий аккаунт
/// и гасит дубль статусом UserStatus.merged — БЕЗ физического удаления, иначе
/// каскады по Membership унесли бы визиты, баллы и согласия.
///
/// @@unique([tenantId, duplicateUserId]) — замок идемпотентности: повторный
/// commit не создаёт вторую запись, а возвращает исходный отчёт.
/// Внешних ключей на User намеренно нет: карта обязана пережить любое будущее
/// удаление пользователя, иначе обезличится ровно тогда, когда понадобится.
model UserMerge {
  id              String   @id @default(cuid())
  tenantId        String
  primaryUserId   String
  duplicateUserId String
  actorUserId     String?
  /// Чем доказано, что это один человек: identity_email | identity_phone |
  /// primary_login_email_digits | operator_bearer_primary
  evidence        String
  /// Счётчики перенесённого и id — без персональных данных.
  reportJson      Json
  createdAt       DateTime @default(now())
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, duplicateUserId])
  @@index([tenantId, primaryUserId])
}

model Membership {
  id                             String                       @id @default(cuid())
  tenantId                       String
  userId                         String
  branchId                       String?
  role                           UserRole
  status                         MembershipStatus             @default(active)
  invitedAt                      DateTime?
  joinedAt                       DateTime?
  createdAt                      DateTime                     @default(now())
  updatedAt                      DateTime                     @updatedAt
  tenant                         Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                           User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch                         Branch?                      @relation(fields: [branchId, tenantId], references: [id, tenantId], onDelete: Restrict)
  authIdentities                 AuthIdentity[]               @relation("AuthIdentityMembership")
  authSessions                   AuthSession[]                @relation("AuthSessionMembership")
  internalProviders              InternalProvider[]           @relation("InternalProviderMembership")
  customerProfile                CustomerProfile?             @relation("CustomerProfileMembership")
  loyaltyAccount                 LoyaltyAccount?              @relation("LoyaltyAccountMembership")
  dashboardPreferences           DashboardPreference[]
  aiBrainSessions                AiBrainSession[]
  aiMemoryFacts                  AiMemoryFact[]
  actionExecutionsAsActor        ActionExecution[]            @relation("ActionActor")
  actionExecutionsAsApprover     ActionExecution[]            @relation("ActionApprover")
  communicationCampaignsCreated  MarketingCampaign[]          @relation("CommunicationCreator")
  communicationCampaignsApproved MarketingCampaign[]          @relation("CommunicationApprover")
  communicationRecipients        MarketingCampaignRecipient[] @relation("CommunicationRecipientMembership")

  @@unique([userId, tenantId])
  @@index([tenantId, status])
  @@index([userId, status])
  @@index([tenantId, branchId])
}

/// Personal dashboard layout and targets for one membership. Preferences are
/// tenant-scoped so the same MAYA account can configure each business safely.
model DashboardPreference {
  id         String     @id @default(cuid())
  tenantId   String
  userId     String
  section    String     @default("finance")
  configJson Json       @default("{}")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [userId, tenantId], references: [userId, tenantId], onDelete: Cascade)

  @@unique([userId, tenantId, section])
  @@index([tenantId, section])
}

/// Tenant-scoped link between a CRM staff record and MAYA access. A role can
/// be prepared before a login is created; userId is attached only when the
/// owner supplies a verified login channel for that staff member.
model CrmStaffAccess {
  id                   String               @id @default(cuid())
  tenantId             String
  externalStaffId      String
  userId               String?
  encryptedDisplayName String
  title                String?
  role                 UserRole
  status               CrmStaffAccessStatus @default(pending_contact)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                 User?                @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// 🔴 Phase A. Грант доступа переезжает на идентичность Maya. Пока nullable:
  /// NOT NULL ставится только на CUTOVER, после доказанного backfill.
  staffId String?
  staff   Staff?  @relation(fields: [staffId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([staffId, tenantId])
  /// НАСЛЕДИЕ: снимается на CUTOVER, не раньше.
  @@unique([tenantId, externalStaffId])
  @@unique([tenantId, userId])
  @@index([tenantId, role, status])
  @@index([userId])
  @@index([staffId])
}

model AuthIdentity {
  id             String     @id @default(cuid())
  tenantId       String
  userId         String
  provider       String
  providerUserId String
  email          String?
  phone          String?
  profileJson    Json?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership     Membership @relation("AuthIdentityMembership", fields: [userId, tenantId], references: [userId, tenantId], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([tenantId, provider, providerUserId])
  @@index([userId])
  @@index([tenantId, provider])
}

model AuthFlowState {
  id           String    @id @default(cuid())
  tenantId     String
  provider     String
  state        String    @unique
  redirectUri  String
  codeVerifier String?
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId, provider, expiresAt])
  @@index([expiresAt])
  @@index([consumedAt])
}

model PhoneAuthCode {
  id         String    @id @default(cuid())
  tenantId   String
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([tenantId, phone])
  @@index([tenantId, expiresAt])
  @@index([expiresAt])
  @@index([consumedAt])
}

model EmailAuthCode {
  id         String    @id @default(cuid())
  tenantId   String
  email      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([tenantId, email])
  @@index([tenantId, expiresAt])
  @@index([expiresAt])
  @@index([consumedAt])
}

model AuthSession {
  id            String             @id @default(cuid())
  tenantId      String?
  userId        String
  deviceLabel   String
  ipHash        String?
  expiresAt     DateTime
  lastUsedAt    DateTime           @default(now())
  revokedAt     DateTime?
  revokeReason  String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  tenant        Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership    Membership?        @relation("AuthSessionMembership", fields: [userId, tenantId], references: [userId, tenantId], onDelete: Cascade)
  refreshTokens AuthRefreshToken[]

  @@index([tenantId, userId, revokedAt])
  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([revokedAt])
}

model AuthRefreshToken {
  id         String      @id
  sessionId  String
  tokenHash  String      @unique
  expiresAt  DateTime
  consumedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime    @default(now())
  session    AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([expiresAt])
}

model AuthRateLimitBucket {
  id              String   @id @default(cuid())
  tenantId        String?
  policyKey       String
  action          String
  scope           String
  subjectHash     String
  attempts        Int      @default(0)
  windowStartedAt DateTime
  windowEndsAt    DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([policyKey, subjectHash])
  @@index([tenantId, action])
  @@index([windowEndsAt])
}

model CrmIntegration {
  id                String    @id @default(cuid())
  tenantId          String    @unique
  provider          String
  encryptedApiToken String
  baseUrl           String?
  status            String    @default("active")
  settingsJson      Json?
  verifiedAt        DateTime?
  lastCheckedAt     DateTime?
  lastSyncAt        DateTime?
  /// 🔴 С какого момента Maya НАБЛЮДАЕТ за этой интеграцией.
  ///
  /// Нужен, чтобы первое сканирование не выдало существующий бизнес за
  /// «создано сегодня»: всё, что старше этой отметки, — `observed_existing`.
  watchStartedAt    DateTime?
  lastErrorCode     String?
  lastErrorAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Payment credentials belonging to one tenant's customer-facing commerce.
/// These credentials are intentionally separate from MAYA subscription billing.
model CommerceIntegration {
  id                 String    @id @default(cuid())
  tenantId           String    @unique
  provider           String    @default("yookassa")
  encryptedShopId    String
  encryptedSecretKey String
  status             String    @default("active")
  verifiedAt         DateTime?
  lastCheckedAt      DateTime?
  lastErrorCode      String?
  lastErrorAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Tenant-owned products and sellable offers. CRM/store adapters may mirror
/// their catalog here, while businesses without an adapter can manage it
/// manually. `kind` is one of inventory, certificate or membership.
model TenantCatalogItem {
  id                String   @id @default(cuid())
  tenantId          String
  kind              String
  name              String
  description       String?
  priceKopecks      Int?
  currency          String   @default("RUB")
  quantity          Int?
  lowStockThreshold Int?
  active            Boolean  @default(true)
  source            String   @default("manual")
  externalRef       String?
  metadataJson      Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, kind, externalRef])
  @@index([tenantId, kind, active])
}

/// One referral policy per tenant. Referral fulfillment remains a separately
/// entitled add-on; this record is the source of truth for its public rules.
model ReferralProgram {
  id                   String   @id @default(cuid())
  tenantId             String   @unique
  enabled              Boolean  @default(false)
  inviterRewardKopecks Int?
  inviteeRewardKopecks Int?
  currency             String   @default("RUB")
  terms                String?
  codePrefix           String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Tenant-scoped referral fact. Creation and terminal resolution remain
/// separate logical actions; reward issuance is deliberately modeled outside
/// this row so a relationship fact cannot itself grant value.
model CustomerReferral {
  id                    String           @id @default(cuid())
  tenantId              String
  createExecutionId     String?
  resolutionExecutionId String?
  referrerClientId      String
  referredClientId      String?
  identityHash          String
  referredSubjectHash   String
  referralCodeHash      String
  status                String           @default("pending")
  joinedAt              DateTime
  resolvedAt            DateTime?
  legacySourceRef       String?
  createdAt             DateTime         @default(now())
  tenant                Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  referrer              Client           @relation("ReferralReferrer", fields: [referrerClientId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  referredClient        Client?          @relation("ReferralReferredClient", fields: [referredClientId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  createExecution       ActionExecution? @relation("CustomerReferralCreateExecution", fields: [createExecutionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  resolutionExecution   ActionExecution? @relation("CustomerReferralResolutionExecution", fields: [resolutionExecutionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  rewardIssuance        ReferralRewardIssuance?

  @@unique([id, tenantId])
  @@unique([tenantId, identityHash])
  @@unique([createExecutionId, tenantId])
  @@unique([resolutionExecutionId, tenantId])
  @@unique([tenantId, legacySourceRef])
  @@index([tenantId, referredSubjectHash, status])
  @@index([tenantId, referrerClientId, joinedAt])
}

/// One reward-issuance batch for one qualified referral. The action binding is
/// one-to-one; its immutable child rows carry the individual recipient values.
model ReferralRewardIssuance {
  id                 String           @id @default(cuid())
  tenantId           String
  referralId         String
  actionExecutionId  String?
  policySnapshotHash String
  issuedAt           DateTime
  legacySourceRef    String?
  createdAt          DateTime         @default(now())
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  referral           CustomerReferral @relation(fields: [referralId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  actionExecution    ActionExecution? @relation("ReferralRewardIssuanceActionExecution", fields: [actionExecutionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  rewards            ReferralReward[]

  @@unique([id, tenantId])
  @@unique([referralId, tenantId])
  @@unique([actionExecutionId, tenantId])
  @@unique([tenantId, legacySourceRef])
  @@index([tenantId, issuedAt])
}

/// One immutable value slot in a referral issuance batch. Money and percentage
/// rewards keep their native domain facts rather than collapsing into a
/// generic value amount.
model ReferralReward {
  id                 String                     @id @default(cuid())
  tenantId           String
  issuanceId         String
  recipientClientId  String
  rewardSlot         String
  codeHash           String
  amountKopecks      Int?
  currency           String?
  percentBasisPoints Int?
  issuedAt           DateTime
  expiresAt          DateTime
  createdAt          DateTime                   @default(now())
  tenant             Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  issuance           ReferralRewardIssuance     @relation(fields: [issuanceId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  recipient          Client                     @relation("ReferralRewardRecipient", fields: [recipientClientId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  fulfillment        ReferralRewardFulfillment?

  @@unique([id, tenantId])
  @@unique([tenantId, codeHash])
  @@unique([issuanceId, tenantId, rewardSlot])
  @@index([tenantId, recipientClientId, expiresAt])
}

/// Append-only claim for applying one referral reward. The unique reward
/// identity blocks a second fulfillment through another execution path.
model ReferralRewardFulfillment {
  id                String           @id @default(cuid())
  tenantId          String
  rewardId          String
  actionExecutionId String?
  fulfilledAt       DateTime
  legacySourceRef   String?
  createdAt         DateTime         @default(now())
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reward            ReferralReward   @relation(fields: [rewardId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  actionExecution   ActionExecution? @relation("ReferralRewardFulfillmentActionExecution", fields: [actionExecutionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, tenantId])
  @@unique([rewardId, tenantId])
  @@unique([actionExecutionId, tenantId])
  @@unique([tenantId, legacySourceRef])
  @@index([tenantId, fulfilledAt])
}

/// One actually activated customer subscription term. A renewal is a new row
/// linked to its predecessor; it never rewrites the predecessor's immutable
/// plan, price, allowance, or term facts.
model CustomerSubscription {
  id                       String                      @id @default(cuid())
  tenantId                 String
  activationExecutionId    String?
  endExecutionId           String?
  clientId                 String
  previousSubscriptionId   String?
  termIdentityHash         String
  planCode                 String
  planSnapshotHash         String
  serviceScopeHash         String
  priceKopecks             Int
  currency                 String
  visitsIncluded           Int
  status                   String                      @default("active")
  provider                 String?
  providerPaymentRefHash   String?
  activatedAt              DateTime
  termStartsAt             DateTime
  termEndsAt               DateTime
  endedAt                  DateTime?
  legacySourceRef          String?
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  tenant                   Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client                   Client                      @relation(fields: [clientId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  activationExecution      ActionExecution?            @relation("CustomerSubscriptionActivationExecution", fields: [activationExecutionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  endExecution             ActionExecution?            @relation("CustomerSubscriptionEndExecution", fields: [endExecutionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  previousSubscription     CustomerSubscription?        @relation("CustomerSubscriptionRenewal", fields: [previousSubscriptionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  renewal                  CustomerSubscription?        @relation("CustomerSubscriptionRenewal")
  usages                   CustomerSubscriptionUsage[]

  @@unique([id, tenantId])
  @@unique([tenantId, termIdentityHash])
  @@unique([activationExecutionId, tenantId])
  @@unique([endExecutionId, tenantId])
  @@unique([previousSubscriptionId, tenantId])
  @@unique([tenantId, provider, providerPaymentRefHash])
  @@unique([tenantId, legacySourceRef])
  @@index([tenantId, clientId, status, termEndsAt])
  @@index([tenantId, status, termEndsAt])
}

/// Append-only evidence that one or more units of a subscription term were
/// consumed. A sync action may own multiple claims, while the subscription-
/// qualified usage identity prevents another execution from claiming the same
/// visit or source event twice.
model CustomerSubscriptionUsage {
  id                       String                @id @default(cuid())
  tenantId                 String
  subscriptionId           String
  actionExecutionId        String?
  usageIdentityHash        String
  targetKind               String
  targetRefHash            String
  units                    Int                   @default(1)
  usedAt                   DateTime
  legacySourceRef          String?
  createdAt                DateTime              @default(now())
  tenant                   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription             CustomerSubscription  @relation(fields: [subscriptionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  actionExecution          ActionExecution?      @relation("CustomerSubscriptionUsageActionExecution", fields: [actionExecutionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, tenantId])
  @@unique([subscriptionId, tenantId, usageIdentityHash])
  @@unique([tenantId, legacySourceRef])
  @@index([actionExecutionId, tenantId])
  @@index([subscriptionId, tenantId, usedAt])
}

/// Review text can contain names and other personal data, so it is encrypted
/// at rest. AI tools receive only rating, source, date and deterministic topic
/// tags, never the original text.
model BusinessReview {
  id              String   @id @default(cuid())
  tenantId        String
  externalRef     String?
  source          String
  rating          Int
  occurredAt      DateTime
  encryptedText   String?
  topicTagsJson   Json?
  branchId        String?
  staffExternalId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, source, externalRef])
  @@index([tenantId, occurredAt])
  @@index([tenantId, rating, occurredAt])
}

model InternalService {
  id                  String                    @id @default(cuid())
  tenantId            String
  name                String
  description         String?
  price               Int
  currency            String                    @default("RUB")
  durationMinutes     Int
  bufferBeforeMinutes Int                       @default(0)
  bufferAfterMinutes  Int                       @default(0)
  active              Boolean                   @default(true)
  sortOrder           Int                       @default(0)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  tenant              Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  providers           InternalProviderService[]

  @@unique([id, tenantId])
  @@index([tenantId, active, sortOrder])
}

model InternalProvider {
  id                  String                          @id @default(cuid())
  tenantId            String
  userId              String?
  branchId            String?
  displayName         String
  title               String?
  specialization      String?
  avatarUrl           String?
  active              Boolean                         @default(true)
  slotIntervalMinutes Int                             @default(30)
  createdAt           DateTime                        @default(now())
  updatedAt           DateTime                        @updatedAt
  tenant              Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                User?                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership          Membership?                     @relation("InternalProviderMembership", fields: [userId, tenantId], references: [userId, tenantId], onDelete: Cascade)
  branch              Branch?                         @relation(fields: [branchId, tenantId], references: [id, tenantId], onDelete: Restrict)
  services            InternalProviderService[]
  availabilityRules   InternalAvailabilityRule[]
  exceptions          InternalAvailabilityException[]

  @@unique([id, tenantId])
  @@unique([tenantId, userId])
  @@index([tenantId, active])
  @@index([branchId])
}

model AiOnboardingDraft {
  id                   String           @id @default(cuid())
  draftTokenHash       String           @unique
  status               String           @default("draft")
  templateId           String
  blueprintJson        Json
  missingFieldsJson    Json
  inputDigest          String?
  lastAssistantMessage String?
  quickRepliesJson     Json             @default("[]")
  lastConfidence       Float?
  needsClarification   Boolean          @default(false)
  interpreterSource    String           @default("safe_fallback")
  turnCount            Int              @default(1)
  expiresAt            DateTime
  confirmedTenantId    String?
  trialActivationId    String?          @unique
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  confirmedTenant      Tenant?          @relation("AiOnboardingConfirmedTenant", fields: [confirmedTenantId], references: [id], onDelete: SetNull)
  trialActivation      TrialActivation? @relation(fields: [trialActivationId], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@index([confirmedTenantId])
}

model TrialActivation {
  id                  String             @id @default(cuid())
  activationTokenHash String             @unique
  status              String             @default("pending")
  source              String             @default("maya_os")
  expiresAt           DateTime
  completedAt         DateTime?
  tenantId            String?            @unique
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  tenant              Tenant?            @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  draft               AiOnboardingDraft?

  @@index([status, expiresAt])
  @@index([completedAt])
}

model CustomerProfile {
  id                 String     @id @default(cuid())
  tenantId           String
  userId             String
  preferredLocale    String?
  privacyConsentAt   DateTime?
  marketingConsentAt DateTime?
  encryptedNotes     String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  tenant             Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership         Membership @relation("CustomerProfileMembership", fields: [userId, tenantId], references: [userId, tenantId], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId, updatedAt])
}

model LoyaltyAccount {
  id                String               @id @default(cuid())
  tenantId          String
  userId            String
  source            String               @default("internal")
  balance           Int                  @default(0)
  externalReference String?
  syncedAt          DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership        Membership           @relation("LoyaltyAccountMembership", fields: [userId, tenantId], references: [userId, tenantId], onDelete: Cascade)
  transactions      LoyaltyTransaction[]

  @@unique([id, tenantId])
  @@unique([userId, tenantId])
  @@index([tenantId, source, updatedAt])
}

model LoyaltyTransaction {
  id                String           @id @default(cuid())
  tenantId          String
  actionExecutionId String?
  accountId         String
  actorUserId       String?
  actorTenantId     String?
  kind              String
  delta             Int
  balanceAfter      Int
  encryptedReason   String
  idempotencyKey    String
  externalRef       String?
  createdAt         DateTime         @default(now())
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account           LoyaltyAccount   @relation(fields: [accountId, tenantId], references: [id, tenantId], onDelete: Cascade)
  actor             User?            @relation("LoyaltyTransactionActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actionExecution   ActionExecution? @relation("LoyaltyTransactionActionExecution", fields: [actionExecutionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, actionExecutionId])
  @@index([tenantId, accountId, createdAt])
  @@index([tenantId, actorUserId, createdAt])
}

/// One tenant-scoped, one-time loyalty right. The bearer code is stored only
/// as a server-derived hash; the immutable target and point value remain
/// domain facts rather than a generic value-ledger payload.
model LoyaltyRedemptionGrant {
  id               String           @id @default(cuid())
  tenantId         String
  issueExecutionId String?
  clientId         String
  codeHash         String
  serviceRef       String
  points           Int
  issuedAt         DateTime
  expiresAt        DateTime
  legacySourceRef  String?
  createdAt        DateTime         @default(now())
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client           Client           @relation(fields: [clientId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  issueExecution   ActionExecution? @relation("LoyaltyRedemptionGrantIssueExecution", fields: [issueExecutionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  redemption       LoyaltyRedemption?

  @@unique([id, tenantId])
  @@unique([tenantId, codeHash])
  @@unique([issueExecutionId, tenantId])
  @@unique([tenantId, legacySourceRef])
  @@index([tenantId, clientId, expiresAt])
}

/// Append-only one-time claim for a loyalty grant. A separate row makes issue
/// and consume distinct logical actions and lets the database reject a second
/// redemption even when it arrives through another execution path.
model LoyaltyRedemption {
  id                String           @id @default(cuid())
  tenantId          String
  grantId           String
  actionExecutionId String?
  redeemedAt        DateTime
  legacySourceRef   String?
  createdAt         DateTime         @default(now())
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  grant             LoyaltyRedemptionGrant @relation(fields: [grantId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  actionExecution   ActionExecution? @relation("LoyaltyRedemptionActionExecution", fields: [actionExecutionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, tenantId])
  @@unique([grantId, tenantId])
  @@unique([actionExecutionId, tenantId])
  @@unique([tenantId, legacySourceRef])
  @@index([tenantId, redeemedAt])
}

model Expense {
  id                String           @id @default(cuid())
  tenantId          String
  actionExecutionId String?
  branchId          String?
  branchTenantId    String?
  createdById       String?
  createdByTenantId String?
  category          String
  amountKopecks     Int
  currency          String           @default("RUB")
  occurredAt        DateTime
  encryptedNote     String?
  source            String           @default("manual")
  externalId        String?
  idempotencyKey    String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch            Branch?          @relation(fields: [branchId, branchTenantId], references: [id, tenantId], onDelete: SetNull)
  createdBy         User?            @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  actionExecution   ActionExecution? @relation("ExpenseActionExecution", fields: [actionExecutionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, tenantId])
  @@unique([actionExecutionId, tenantId])
  @@unique([tenantId, externalId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, occurredAt])
  @@index([tenantId, branchId, occurredAt])
  @@index([tenantId, source, occurredAt])
}

/// Явное подтверждение владельца, что за конкретный период все расходы,
/// кроме системной зарплаты из CRM, уже внесены. Нулевая аренда не создаётся:
/// собственное помещение — нормальный сценарий, а не фиктивный расход.
model ExpensePeriodDeclaration {
  id                String           @id @default(cuid())
  tenantId          String
  actionExecutionId String?
  declaredById      String?
  periodFromDay     String
  periodToDay       String
  idempotencyKey    String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  declaredBy        User?            @relation("ExpensePeriodDeclarer", fields: [declaredById], references: [id], onDelete: SetNull)
  actionExecution   ActionExecution? @relation("ExpensePeriodDeclarationActionExecution", fields: [actionExecutionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([actionExecutionId, tenantId])
  @@unique([tenantId, periodFromDay, periodToDay])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, periodFromDay, periodToDay])
}

model AiApprovalRequest {
  id                  String           @id @default(cuid())
  tenantId            String
  requestedByUserId   String?
  requestedByTenantId String?
  decidedByUserId     String?
  decidedByTenantId   String?
  toolName            String
  surface             String
  riskTier            String
  approvalPolicy      String
