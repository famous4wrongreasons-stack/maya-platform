// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                     String                          @id @default(cuid())
  name                   String
  slug                   String                          @unique
  status                 String                          @default("trial")
  planId                 String?
  industryPresetId       String?
  calendarSource         String                          @default("external")
  defaultCurrency        String                          @default("RUB")
  defaultTimezone        String                          @default("Europe/Moscow")
  defaultLocale          String                          @default("ru-RU")
  customDomain           String?                         @unique
  subdomain              String?                         @unique
  trialEndsAt            DateTime?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  billingMethodId        String?
  allowSelfRegistration  Boolean                         @default(true)
  createdAt              DateTime                        @default(now())
  updatedAt              DateTime                        @updatedAt
  plan                   SubscriptionPlan?               @relation(fields: [planId], references: [id])
  brandingSettings       BrandingSettings?
  branches               Branch[]
  users                  User[]
  crmIntegration         CrmIntegration?
  auditLogs              AuditLog[]
  appointments           Appointment[]
  phoneAuthCodes         PhoneAuthCode[]
  authIdentities         AuthIdentity[]
  authFlowStates         AuthFlowState[]
  authSessions           AuthSession[]
  authRateLimitBuckets   AuthRateLimitBucket[]
  billingPayments        BillingPayment[]
  memberships            Membership[]
  entitlements           TenantEntitlement[]
  internalServices       InternalService[]
  internalProviders      InternalProvider[]
  availabilityRules      InternalAvailabilityRule[]
  availabilityExceptions InternalAvailabilityException[]
  aiOnboardingDrafts     AiOnboardingDraft[]             @relation("AiOnboardingConfirmedTenant")
}

/// Persisted white-label BrandingConfig. The database model name is retained
/// during the compatibility phase so existing Prisma calls keep working.
model BrandingSettings {
  id                   String   @id @default(cuid())
  tenantId             String   @unique
  logoUrl              String?
  iconUrl              String?
  faviconUrl           String?
  appName              String?
  primaryColor         String?
  secondaryColor       String?
  accentColor          String?
  backgroundColor      String?
  surfaceColor         String?
  textPrimaryColor     String?
  textSecondaryColor   String?
  backgroundImageUrl   String?
  fontFamily           String?
  headingFontFamily    String?
  buttonRadius         Int?
  buttonStyle          String?
  themeMode            String   @default("system")
  borderRadiusJson     Json?
  contactDetailsJson   Json?
  socialLinksJson      Json?
  mapLinksJson         Json?
  legalLinksJson       Json?
  splashScreenJson     Json?
  onboardingJson       Json?
  storeListingJson     Json?
  emailBrandingJson    Json?
  telegramBrandingJson Json?
  themeJson            Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Branch {
  id                String             @id @default(cuid())
  tenantId          String
  name              String
  address           String?
  phone             String?
  timezone          String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users             User[]
  appointments      Appointment[]
  internalProviders InternalProvider[]

  @@index([tenantId])
}

model User {
  id                String             @id @default(cuid())
  tenantId          String?
  branchId          String?
  email             String
  phone             String?
  encryptedName     String?
  passwordHash      String
  role              String
  status            String             @default("active")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  tenant            Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch            Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  auditLogs         AuditLog[]
  appointments      Appointment[]      @relation("ClientAppointments")
  authIdentities    AuthIdentity[]
  authSessions      AuthSession[]
  memberships       Membership[]
  internalProviders InternalProvider[]

  @@unique([id, tenantId])
  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([branchId])
}

model Membership {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  role      String
  status    String    @default("active")
  invitedAt DateTime?
  joinedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId, status])
  @@index([userId, status])
}

model AuthIdentity {
  id             String   @id @default(cuid())
  tenantId       String
  userId         String
  provider       String
  providerUserId String
  email          String?
  phone          String?
  profileJson    Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([tenantId, provider, providerUserId])
  @@index([userId])
  @@index([tenantId, provider])
}

model AuthFlowState {
  id           String    @id @default(cuid())
  tenantId     String
  provider     String
  state        String    @unique
  redirectUri  String
  codeVerifier String?
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId, provider, expiresAt])
  @@index([expiresAt])
  @@index([consumedAt])
}

model PhoneAuthCode {
  id         String    @id @default(cuid())
  tenantId   String
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([tenantId, phone])
  @@index([tenantId, expiresAt])
  @@index([expiresAt])
  @@index([consumedAt])
}

model AuthSession {
  id            String             @id @default(cuid())
  tenantId      String?
  userId        String
  deviceLabel   String
  ipHash        String?
  expiresAt     DateTime
  lastUsedAt    DateTime           @default(now())
  revokedAt     DateTime?
  revokeReason  String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  tenant        Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens AuthRefreshToken[]

  @@index([tenantId, userId, revokedAt])
  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([revokedAt])
}

model AuthRefreshToken {
  id         String      @id
  sessionId  String
  tokenHash  String      @unique
  expiresAt  DateTime
  consumedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime    @default(now())
  session    AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([expiresAt])
}

model AuthRateLimitBucket {
  id              String   @id @default(cuid())
  tenantId        String?
  policyKey       String
  action          String
  scope           String
  subjectHash     String
  attempts        Int      @default(0)
  windowStartedAt DateTime
  windowEndsAt    DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([policyKey, subjectHash])
  @@index([tenantId, action])
  @@index([windowEndsAt])
}

model CrmIntegration {
  id                String   @id @default(cuid())
  tenantId          String   @unique
  provider          String
  encryptedApiToken String
  baseUrl           String?
  status            String   @default("active")
  settingsJson      Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model InternalService {
  id                  String                    @id @default(cuid())
  tenantId            String
  name                String
  description         String?
  price               Int
  currency            String                    @default("RUB")
  durationMinutes     Int
  bufferBeforeMinutes Int                       @default(0)
  bufferAfterMinutes  Int                       @default(0)
  active              Boolean                   @default(true)
  sortOrder           Int                       @default(0)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  tenant              Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  providers           InternalProviderService[]

  @@unique([id, tenantId])
  @@index([tenantId, active, sortOrder])
}

model InternalProvider {
  id                  String                          @id @default(cuid())
  tenantId            String
  userId              String?
  branchId            String?
  displayName         String
  title               String?
  specialization      String?
  avatarUrl           String?
  active              Boolean                         @default(true)
  slotIntervalMinutes Int                             @default(30)
  createdAt           DateTime                        @default(now())
  updatedAt           DateTime                        @updatedAt
  tenant              Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                User?                           @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Cascade)
  branch              Branch?                         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  services            InternalProviderService[]
  availabilityRules   InternalAvailabilityRule[]
  exceptions          InternalAvailabilityException[]

  @@unique([id, tenantId])
  @@unique([tenantId, userId])
  @@index([tenantId, active])
  @@index([branchId])
}

model AiOnboardingDraft {
  id                String   @id @default(cuid())
  draftTokenHash    String   @unique
  status            String   @default("draft")
  templateId        String
  blueprintJson     Json
  missingFieldsJson Json
  inputDigest       String?
  expiresAt         DateTime
  confirmedTenantId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  confirmedTenant   Tenant?  @relation("AiOnboardingConfirmedTenant", fields: [confirmedTenantId], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@index([confirmedTenantId])
}

model InternalProviderService {
  tenantId   String
  providerId String
  serviceId  String
  active     Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  provider   InternalProvider @relation(fields: [providerId, tenantId], references: [id, tenantId], onDelete: Cascade)
  service    InternalService  @relation(fields: [serviceId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@id([tenantId, providerId, serviceId])
  @@index([tenantId, serviceId, active])
}

model InternalAvailabilityRule {
  id          String           @id @default(cuid())
  tenantId    String
  providerId  String
  weekday     Int
  startMinute Int
  endMinute   Int
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider    InternalProvider @relation(fields: [providerId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([tenantId, providerId, weekday, startMinute, endMinute])
  @@index([tenantId, providerId, weekday, active])
}

model InternalAvailabilityException {
  id         String           @id @default(cuid())
  tenantId   String
  providerId String
  startAt    DateTime
  endAt      DateTime
  kind       String           @default("unavailable")
  note       String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider   InternalProvider @relation(fields: [providerId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, providerId, startAt, endAt])
}

model SubscriptionPlan {
  id                  String            @id @default(cuid())
  name                String            @unique
  priceMonthly        Int
  maxBranches         Int
  maxStaff            Int
  featuresJson        Json?
  isWhiteLabelEnabled Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  tenants             Tenant[]
  billingPayments     BillingPayment[]
  entitlements        PlanEntitlement[]
}

model Feature {
  key                String              @id
  name               String
  description        String?
  module             String
  status             String              @default("active")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  planEntitlements   PlanEntitlement[]
  tenantEntitlements TenantEntitlement[]
}

model PlanEntitlement {
  id         String           @id @default(cuid())
  planId     String
  featureKey String
  enabled    Boolean          @default(true)
  configJson Json?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  plan       SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature    Feature          @relation(fields: [featureKey], references: [key], onDelete: Cascade)

  @@unique([planId, featureKey])
  @@index([featureKey, enabled])
}

model TenantEntitlement {
  id         String    @id @default(cuid())
  tenantId   String
  featureKey String
  enabled    Boolean
  configJson Json?
  reason     String?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feature    Feature   @relation(fields: [featureKey], references: [key], onDelete: Cascade)

  @@unique([tenantId, featureKey])
  @@index([tenantId, enabled, expiresAt])
}

model BillingPayment {
  id                String            @id @default(cuid())
  tenantId          String
  planId            String?
  provider          String            @default("yookassa")
  providerPaymentId String?           @unique
  idempotenceKey    String            @unique
  purpose           String
  status            String            @default("pending")
  amountKopecks     Int
  currency          String            @default("RUB")
  confirmationUrl   String?
  returnUrl         String?
  paidAt            DateTime?
  canceledAt        DateTime?
  providerPayload   Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan              SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@unique([id, tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([provider, providerPaymentId])
}

model AuditLog {
  id           String   @id @default(cuid())
  tenantId     String
  userId       String?
  action       String
  entityType   String
  entityId     String
  metadataJson Json?
  createdAt    DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
}

model Appointment {
  id              String   @id @default(cuid())
  tenantId        String
  clientId        String
  branchId        String?
  crmExternalId   String?
  source          String   @default("external")
  staffExternalId String
  serviceIds      Json
  startAt         DateTime
  endAt           DateTime
  blockedStartAt  DateTime
  blockedEndAt    DateTime
  status          String   @default("confirmed")
  notes           String?
  providerPayload Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client          User     @relation("ClientAppointments", fields: [clientId], references: [id], onDelete: Cascade)
  branch          Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([id, tenantId, clientId])
  @@index([tenantId])
  @@index([clientId])
  @@index([branchId])
  @@index([tenantId, staffExternalId, startAt])
}
