            "description": "номер страницы",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "count",
            "in": "query",
            "description": "количество товаров на странице",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "category_id",
            "in": "query",
            "description": "Id категории товаров",
