{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": "widgets-live/current-candidate-http\\.probe-spec\\.ts$",
  "transform": {
    "^.+\\.mjs$": "<rootDir>/widgets-live/support/current-candidate-mjs-transform.cjs",
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "globalSetup": "<rootDir>/widgets-live/support/global-setup.ts",
  "setupFiles": [
    "<rootDir>/widgets-live/support/setup-environment.ts"
  ],
  "testTimeout": 120000
}
