{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": "widgets-live/.*\\.live-spec\\.ts$",
  "transform": {
    "^.+/(?:local-owner-telegram-(?:policy|transport|runtime)|local-owner-scope|local-onboarding-profile)\\.mjs$": "<rootDir>/widgets-live/support/local-owner-telegram-mjs-transform.cjs",
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "globalSetup": "<rootDir>/widgets-live/support/global-setup.ts",
  "setupFiles": ["<rootDir>/widgets-live/support/setup-environment.ts"],
  "testTimeout": 120000
}
