    "outDir": "./dist",
    "declaration": false,
    "sourceMap": false,
    "incremental": false,
    "noEmit": false
  },
  "include": [
    "scripts/release-preflight.ts",
    "scripts/staff-identity-backfill.ts",
    "src/config/**/*.ts"
  ],
  "exclude": ["**/*.spec.ts"]
}
