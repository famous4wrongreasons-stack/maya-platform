  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "declaration": false,
    "sourceMap": false,
    "incremental": false,
    "noEmit": false
  },
  "include": [
    "scripts/release-preflight.ts",
    "scripts/staff-identity-backfill.ts",
    "scripts/appointment-mirror-bootstrap.ts",
    "scripts/appointment-reconciliation-run.ts",
    "scripts/quarantine-catchup-run.ts",
    "scripts/opportunity-shadow.ts",
    "scripts/opportunity-lifecycle-shadow.ts",
    "scripts/opportunity-lifecycle-run.ts",
    "scripts/opportunity-lifecycle-proof.ts",
    "scripts/action-engine-kernel-proof.ts",
    "src/config/**/*.ts"
  ],
  "exclude": ["**/*.spec.ts"]
}
